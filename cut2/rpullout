#!/usr/bin/env python3
"""
rpullout - Like pullout, but anchored from the end instead of the start.

Reads lines (or, with -m, the whole input) from a program's output on
stdin and, for each match of

    <want> ... <amatch>

prints the *last* (rightmost) occurrence of <want> that appears before
<amatch> - not simply the first one a lazy regex would find. This is
useful when you know what comes *after* the value you want but not
what comes before it.

Usage:
    <prog> | rpullout [-d] [-m] '<want>' '<amatch>'

Where:
    <prog>     = the program whose output you want to filter
    rpullout   = this program
    -d         = don't add the .*? gap between <want> and <amatch>
    -m         = multiline match mode (. can match a newline; the whole
                 input is read at once and every match is reported)
    <want>     = the bit that you want to see
    <amatch>   = a regex to match that occurs after the <want> param

Without -m, each input line is matched independently and only the
first match per line is used. With -m, the entire input is treated as
one block of text and every non-overlapping match is reported.

Example:
    cat /etc/hosts | rpullout '^\\d\\S+' 'cmdesktop'

    echo 'one two three STOP' | rpullout '\\w+' 'STOP'
        -> three
"""

import argparse
import re
import sys


def usage(parser):
    parser.print_usage(sys.stderr)
    sys.exit(2)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="rpullout",
        add_help=False,
        description="Print the last occurrence of <want> found before <amatch>.",
    )
    parser.add_argument("-d", dest="dont", action="store_true", help="don't add the .*? gap")
    parser.add_argument("-m", dest="multi", action="store_true", help="multiline match mode")
    parser.add_argument("want", nargs="?")
    parser.add_argument("amatch", nargs="?")
    return parser


def strip_leading_newline(s):
    return s[1:] if s.startswith("\n") else s


def strip_trailing_newline(s):
    return s[:-1] if s.endswith("\n") else s


def find_matches(text_or_lines, pattern, multi):
    """Return a list of (want, gap, amatch) tuples for the outer match."""
    matches = []
    if multi:
        regex = re.compile(pattern, re.IGNORECASE | re.DOTALL)
        pos = 0
        text = text_or_lines
        while True:
            m = regex.search(text, pos)
            if not m:
                break
            groups = [g if g is not None else "" for g in m.groups()]
            groups = [strip_trailing_newline(g) for g in groups]
            matches.append(tuple(groups))
            pos = m.end()
            if m.end() == m.start():
                pos += 1
    else:
        regex = re.compile(pattern, re.IGNORECASE)
        for line in text_or_lines:
            m = regex.search(line)
            if m:
                groups = [g if g is not None else "" for g in m.groups()]
                matches.append(tuple(groups))
    return matches


def refine_to_last(want_pattern, a1, b1):
    """Walk the gap b1, repeatedly re-matching want_pattern, to find the
    rightmost occurrence of <want> that precedes <amatch>."""
    refine_re = re.compile(r"^.*?(" + want_pattern + r")(.*?)$", re.IGNORECASE | re.DOTALL)
    while True:
        if b1:
            m = refine_re.match(b1)
        else:
            m = None
        if m:
            a1 = m.group(1)
            b1 = m.group(2)
            continue
        return strip_leading_newline(a1)


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.want is None or args.amatch is None:
        usage(parser)

    if not args.want:
        print("error: <want> must not be empty", file=sys.stderr)
        return 1
    if not args.amatch:
        print("error: <amatch> must not be empty", file=sys.stderr)
        return 1

    span = "" if args.dont else ".*?"
    pattern = f"({args.want})({span})({args.amatch})"

    if args.multi:
        text = sys.stdin.read()
        matches = find_matches(text, pattern, True)
    else:
        lines = sys.stdin.read().splitlines()
        matches = find_matches(lines, pattern, False)

    for want, gap, _amatch in matches:
        print(refine_to_last(args.want, want, gap))

    return 0


if __name__ == "__main__":
    sys.exit(main())
