#!/usr/bin/env bash
# -*-Shell-*-

#################################################
#                                               #
#   Configure script for env2                   #
#                                               #
#################################################

###################################
# Prepare the sample_script with the desired #! line
###################################
function set_sample_script {
  local iargs="$1"
  local inter="$PWD/sample_interpreter"
  
  echo "#!$inter $iargs" > sample_script.si
  cat sample_script.si.template >> sample_script.si
  chmod 755 sample_script.si
}

###################################
# Find out whether the kernel cuts off (or refuses) a long #! line.
#   Tries one long argument, ending in the letter E, on lines of decreasing length, until
#   the script runs.  If the E arrives, the line is not cut.  If it does not, the kernel kept
#   only part of the line.  Sets $line_limit to the number of bytes of the line (from the
#   "#!") the kernel is known to keep, or 0 for no limit.  (env2 uses this to know when a
#   line may have been cut, and reads it from the script instead.)
# Needs sample_interpreter (the probe) and $PWD; sets and restores the sample script.
###################################
function probe_line_limit {
  local len word out arg line_len found=0
  local inter="$PWD/sample_interpreter"
  line_limit=0
  for len in 4000 1000 500 250 120 60; do
    word=$(printf '%*s' $len '' | tr ' ' x)
    set_sample_script "-${word}E"
    if [[ -n $KERNEL_SHIM ]]; then
      out=$(perl t/fakekernel.pl "$KERNEL_SHIM" ./sample_script.si 2>/dev/null)
    else
      out=$(./sample_script.si 2>/dev/null)
    fi
    arg=$(printf '%s\n' "$out" | sed -n "2s/^arg1='\(.*\)'\$/\1/p")   # what the probe got as its first argument
    line_len=$(( 2 + ${#inter} + 1 + len + 2 ))                      # "#!" + path + " " + "-" + x's + "E"
    if [[ -z $arg ]]; then
      continue                                                       # would not run: try a shorter line
    elif [[ $arg == *E ]]; then
      line_limit=$(( len == 4000 ? 0 : line_len ))                   # arrived whole
      found=1
      break
    else
      line_limit=$(( 2 + ${#inter} + 1 + ${#arg} ))                  # cut: this much was kept
      found=1
      break
    fi
  done
  if   [[ $found == 0 ]]; then
    echo "config warning: no long #! line could be tested; assuming a limit of 60 bytes"
    line_limit=60
  elif [[ $line_limit == 0 ]]; then
    echo "config info: kernel does NOT limit the length of the #! line (tried $len bytes)"
  else
    echo "config info: kernel limits the #! line to about $line_limit bytes"
    echo "config info: (env2 will read a line that long from the script itself)"
  fi
  set_sample_script '-a:b\ c -d'      # put the usual sample script back
}

###################################
# main
###################################
function main {
  local ks line_limit

  # Which make? The Makefile needs GNU make, which is called gmake on Solaris and
  # the BSDs (and plain make elsewhere). MAKE=... overrides.
  if [[ -z $MAKE ]]; then
    if command -v gmake >/dev/null 2>&1; then MAKE=gmake; else MAKE=make; fi
  fi

  # Create config.mk #######################################
  echo "=== 1. Create config.mk"
  rm -f config.mk
  case $(uname) in
    Linux)
      cat > config.mk <<'_HERE_'

# Site customizable variables (change as needed)
PREFIX    = /usr/local
CXX       = g++
CXXFLAGS  = -Wall -g -std=c++14 -DUNAME=UNAME_LINUX -DPREFIX=$(PREFIX)
LDXX      = $(CXX)
LDXXFLAGS = 
LDXXLIBS  = 

_HERE_
      ;;
    CYGWIN*)
      cat > config.mk <<'_HERE_'

# Site customizable variables (change as needed)
PREFIX    = /usr/local
CXX       = g++
CXXFLAGS  = -Wall -g -std=c++14 -D_POSIX_C_SOURCE=201401L -DUNAME=UNAME_CYGWIN -DPREFIX=$(PREFIX)
LDXX      = $(CXX)
LDXXFLAGS = 
LDXXLIBS  = 

_HERE_
      ;;
    SunOS|Solaris)
      echo "*** config note: remember to use gmake not make ***"
      cat > config.mk <<'_HERE_'

# Site customizable variables (change as needed)
PREFIX    = /usr/local
CXX       = CC
CXXFLAGS  = -Wall -g -std=c++14 -D_XPG6 -DUNAME=UNAME_SOLARIS -DPREFIX=$(PREFIX)
LDXX      = $(CXX)
LDXXFLAGS = -std=c++14
LDXXLIBS  = 

_HERE_
      ;;
    Darwin|*BSD)
      cat > config.mk <<'_HERE_'

# Site customizable variables (change as needed)
PREFIX    = /usr/local
CXX       = clang++
CXXFLAGS  = -Wall -g -std=c++14 -DUNAME=UNAME_MACOS -DPREFIX=$(PREFIX)
LDXX      = $(CXX)
LDXXFLAGS = 
LDXXLIBS  = 

_HERE_
      ;;
    *)
      echo "config error: unrecognized platform: $(uname)"
      exit 1
  esac

  # Clean #################################################
  echo "=== 2. Cleaning"
  # (clean, not distclean: that would delete the config.mk made in step 1;
  #  config.hh and t/exp* are regenerated below)
  $MAKE clean

  # Test to see kernel behaviour of #! splitting ##########
  echo "=== 3. Testing kernel #! parsing"
  echo "#pragma once" > config.hh
  $MAKE da
  set_sample_script '-a:b\ c -d'
  ln -fs da sample_interpreter
	declare -a args
	OIFS="$IFS"
	IFS='
'
  # KERNEL_SHIM=linux|naive|solaris|perfect pretends to be a different kernel
  #   (used by test_configure.sh); normally the real kernel runs the script
  if [[ -n $KERNEL_SHIM ]]; then
    args=($(perl t/fakekernel.pl "$KERNEL_SHIM" ./sample_script.si 2>/dev/null))
  else
    args=($(./sample_script.si 2>/dev/null))
  fi
	IFS="$OIFS"
	# test split
  if   [[ ${args[1]} == *"d'" ]]; then                      # Linux/FreeBSD
    echo "config info: kernel does NOT split #! line"     
    ks=linux
  elif [[ ${args[1]} == *"b"?"'" ]]; then                   # Solaris/Darwin
    echo "config info: kernel DOES split #! line but does NOT handle escaped whitespace"
    ks=naive
  elif [[ ${args[1]} == *"c'" ]]; then                      # Perfect!
    # No such kernel is known.  the naive kernel (re-read the #! line from the
    #   script and split it ourselves) gives the right answer here too.
    echo "config info: kernel DOES split #! line and DOES handle escaped whitespace"
    echo "config info: (using the naive kernel, which also works on such a kernel)"
    ks=naive
  else
    # Some behaviour we have not met.  Every kernel except linux gets the same treatment:
    #   env2 reads the #! line from the script itself, whatever the kernel did to it.
    #   So guess the naive kernel instead of giving up.
    echo "config warning: unrecognised kernel handling of the #! line: '${args[1]}'"
    echo "config info: (using the naive kernel, which re-reads the #! line from the script)"
    ks=naive
  fi
	# test truncate
  if   [[ ${args[2]} == *".si'" ]]; then
	  if [[ $ks == linux ]]; then                                 # Linux/FreeBSD
      echo "config info: kernel does NOT truncate #! line"  
		else                                                    # Solaris
      echo "config info: kernel DOES truncate #! line"      
      ks=solaris
		fi
  elif [[ ${args[2]} == *"c'" ]]; then                      # Darwin
    echo "config info: kernel does NOT truncate #! line"    
  elif [[ ${args[2]} == *"d'" ]]; then                      # Perfect!
    echo "config info: kernel does NOT truncate #! line"    
  else
    echo "config warning: unrecognised handling of the script name after the #! line: '${args[2]}'"
    echo "config info: (assuming the kernel does not truncate the #! line)"
  fi
  # test the length of the #! line
  probe_line_limit
	# create config header
  echo "#define KERNEL KERNEL_$(echo $ks | tr a-z A-Z)" >> config.hh
  echo "#define KERNEL_LINE_LIMIT $line_limit" >> config.hh
  cat >> config.hh <<'_HERE_'
#define KERNEL_LINUX   0
#define KERNEL_NAIVE   1
#define KERNEL_SOLARIS 2
#define UNAME_LINUX   1
#define UNAME_CYGWIN  2
#define UNAME_SOLARIS 3
#define UNAME_MACOS   4
_HERE_

  # copy correct test exp to t dir #########################
  echo "=== 4. Picking test exp files"
  # (the solaris kernel truncates the line, but the tests expect what the naive one gives)
  cp t/$([[ $ks == solaris ]] && echo naive || echo $ks)/* t

  # Fix paths ##############################################
  echo "=== 5. Fixing paths"
  $MAKE fixpaths
  
}
main ${1+"$@"}
