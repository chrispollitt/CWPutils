#!/usr/bin/env python3
"""termprobe: what survives the trip between a program and its terminal on THIS path?

    termprobe [--timeout S] [--label TEXT] [--raw] [--input | --tvision] [--dos [--no-visual] [--no-mouse]] [--no-vt-input]

Run it in every terminal / shell / ssh combination you care about and compare.  It asks the terminal, in one burst,
the questions a capability-negotiating TUI (tvision, notcurses, vim, ...) asks:

    OSC 10 / 11        foreground / background colour
    DA1, DA2, XTVERSION    who are you
    CSI 18t / 14t / 16t    size in characters / in pixels / of one cell
    CSI 6n             cursor position
    kitty keyboard, modifyOtherKeys    which key encodings
    DECRQM 1000 1006 2004 2026 9001    mouse, SGR mouse, bracketed paste, synchronized output, win32-input-mode

and then checks what came back, not just whether something did.  Two verdicts:

  OSC 11    ANSWERED   the colour reply came back                                            exit 0
            DROPPED    something answered but not the colour query (ignored, or eaten on the way)
            SILENT     nothing came back at all
  NEGOTIATION   CLEAN  every reply that came is whole, single and consistent
                MANGLED  replies doubled (two layers both answered), bytes that are no known reply (garbage that would
                         land on a TUI's screen), a size that disagrees with the real window, a DA1 that is conhost's
                         canned "1;0".  Worth knowing but not a fault, so only printed as a "note:": win32-input-mode
                         (9001) being on, which Windows Terminal / ConPTY normally have.  On a Cygwin console
                         (/dev/cons*) a dropped OSC 11 gets a hint to use wincygterm, mintty or ssh.

A terminal that does not know a query stays quiet; that is listed as "no reply", not as a fault.  It waits the whole
timeout unless every query has been answered: ConPTY answers DA1 itself, at once, while the other queries have to go
to the terminal and back, so DA1 arriving first proves nothing.

--input adds a keyboard and mouse fidelity test: it turns on SGR mouse reporting, asks you to type, click and press
the arrow keys, and reports what arrived (dropped keystrokes, missing clicks, win32-input-mode sequences).
--tvision does the same after setting the terminal up exactly as tvision does at startup (win32-input-mode 9001,
kitty keys, modifyOtherKeys, mouse), decodes the win32-input-mode records, and counts records that were cut in two
across reads, with the time the rest took.  A program that waits only a few ms for the rest (ncurses: ESCDELAY and
its read timeout, 10 ms by default) takes the ESC for the Escape key, and the rest shows on screen as
"[68;32;100;1;0;1_".  That is how tvmail failed over ssh from Windows Terminal: the gaps were 16-33 ms.
A program can turn 9001 on itself, so a plain printf of ESC [ ? 9001 l beforehand changes nothing for tvision.
--dos tests the classic DOS / Windows screen-control set (see TUIs/tvcommon/TERMINAL-HISTORY.md, sections 2 and 4):
the ANSI.SYS sequences (CUP HVP CUU CUD CUF CUB, SCP/RCP, ED, EL, SGR, DSR, line-wrap mode), the 16-colour attribute byte
(bright foreground and background, blink), the DOS cursor shape, and the 256 CP437 glyphs (smileys, card suits, box lines,
blocks).  Cursor behaviour is measured, not eyeballed: each sequence is followed by ESC[6n and the reported position is
compared with what DOS would do.  Attributes are read back with DECRQSS.  Whatever cannot be measured (erase, how colours
and CP437 look) is drawn on the screen afterwards with a line saying what you should see; --no-visual leaves that out.
--dos also tests the mouse both ways (interactive: click three times, twice, 8 s each; --no-mouse skips it): as escape-
sequence reports (xterm SGR, what tvision / ncurses / vim ask for) and as console mouse events (conhost's
ENABLE_MOUSE_INPUT and MOUSE_EVENT records, what Microsoft Edit and Windows-API programs use).  The second needs a
Windows console program: on native Windows it runs in-process; under Cygwin / MSYS a native Windows Python (py or
python.exe on PATH) is started from the shell, which is exactly "a Windows program started from here".  A pty with only
text behind it (wincygterm without `wcdirect`) shows up as: escape-sequence mouse works, console mouse events do not.
It never changes the exit code: a terminal without blink is a fact, not a fault.
Every run, in every mode, ends with a SUMMARY of the findings: [ ok ], [warn], [FAIL], [info].
--no-vt-input (native Windows only) leaves ENABLE_VIRTUAL_TERMINAL_INPUT off, as for a program that reads key events.

Talks to the controlling terminal (/dev/tty on POSIX: Linux, WSL, macOS, Cygwin, MSYS, mintty; CONIN$ / CONOUT$ with
native Windows Python), so it works with stdin / stdout redirected.  Python 3.8+, standard library only.
Exit codes: 0 all clean, 1 a problem found, 2 no terminal.
"""
from __future__ import print_function

import argparse
import os
import platform
import re
import shutil
import subprocess
import sys
import textwrap
import time

GRACE = 0.3                                              # seconds to go on listening once every query is answered
ESC = "\x1b"
ST = r"(?:\x07|\x1b\\)"                                  # string terminator: BEL or ESC \
_RGB = re.compile(r"rgba?:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)")
DECRQM_STATE = {0: "not recognised", 1: "set (on)", 2: "reset (off)", 3: "permanently on", 4: "permanently off"}


class Query(object):
    def __init__(self, key, name, seq, pattern, show=None):
        self.key, self.name, self.seq = key, name, seq
        self.pat = re.compile(pattern, re.S)
        self.show = show or (lambda m, ctx: m.group(1))


def parse_rgb(body):
    """(r, g, b) 0..255 from 'rgb:RRRR/GGGG/BBBB' (any digits per channel), or None."""
    m = _RGB.match(body)
    if not m:
        return None
    return tuple(int(round(int(g, 16) / float(16 ** len(g) - 1) * 255)) for g in m.groups())


def _colour(m, ctx):
    rgb = parse_rgb(m.group(1))
    return "%r  = rgb%s" % (m.group(1), rgb) if rgb else "%r  (unparsed)" % m.group(1)


def _da1(m, ctx):
    return "%r%s" % (m.group(1), "   <- conhost's canned reply, not the terminal's" if m.group(1) == "1;0" else "")


def _size(m, ctx):
    rows, cols = int(m.group(1)), int(m.group(2))
    real = ctx.get("size")
    note = ""
    if real and (rows, cols) != real[:2]:
        note = "   <- the window is %dx%d" % (real[1], real[0])
    return "%d rows x %d cols%s" % (rows, cols, note)


def _px(m, ctx):
    return "%s x %s px (h x w)" % (m.group(1), m.group(2))


def _decrqm(mode, label):
    return Query("mode%d" % mode, "DECRQM %d (%s)" % (mode, label), "\x1b[?%d$p" % mode,
                 r"\x1b\[\?%d;(\d)\$y" % mode, lambda m, ctx: DECRQM_STATE.get(int(m.group(1)), m.group(1)))


QUERIES = (
    Query("fg", "OSC 10 (foreground)", "\x1b]10;?\x1b\\", r"\x1b\]10;([^\x07\x1b]*)" + ST, _colour),
    Query("bg", "OSC 11 (background)", "\x1b]11;?\x1b\\", r"\x1b\]11;([^\x07\x1b]*)" + ST, _colour),
    Query("xtver", "XTVERSION", "\x1b[>0q", r"\x1bP>\|(.*?)\x1b\\", lambda m, ctx: repr(m.group(1))),
    Query("da2", "DA2 (secondary attrs)", "\x1b[>c", r"\x1b\[>([0-9;]*)c", lambda m, ctx: repr(m.group(1))),
    Query("size18", "CSI 18t (size, chars)", "\x1b[18t", r"\x1b\[8;(\d+);(\d+)t", _size),
    Query("pix14", "CSI 14t (size, pixels)", "\x1b[14t", r"\x1b\[4;(\d+);(\d+)t", _px),
    Query("cell16", "CSI 16t (cell, pixels)", "\x1b[16t", r"\x1b\[6;(\d+);(\d+)t", _px),
    Query("cpr", "CSI 6n (cursor pos)", "\x1b[6n", r"\x1b\[(\d+);(\d+)R", lambda m, ctx: "row %s, col %s" % m.groups()),
    Query("kitty", "kitty keyboard flags", "\x1b[?u", r"\x1b\[\?(\d+)u", lambda m, ctx: "flags %s" % m.group(1)),
    Query("modkeys", "modifyOtherKeys", "\x1b[?4m", r"\x1b\[>4;(\d+)m", lambda m, ctx: "level %s" % m.group(1)),
    _decrqm(1000, "mouse"), _decrqm(1006, "SGR mouse"), _decrqm(2004, "bracketed paste"),
    _decrqm(2026, "synchronized output"), _decrqm(9001, "win32-input-mode"),
    Query("da1", "DA1 (device attributes)", "\x1b[c", r"\x1b\[\?([0-9;]*)c", _da1),      # last: the others are the point
)
BY_KEY = dict((q.key, q) for q in QUERIES)


class PosixTty(object):
    def __init__(self):
        import termios
        import tty
        self._termios = termios
        self.fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
        self._old = termios.tcgetattr(self.fd)
        tty.setcbreak(self.fd, termios.TCSANOW)

    def write(self, text):
        os.write(self.fd, text.encode("utf-8"))                                  # the queries are ASCII; --dos sends glyphs

    def info(self):
        return []

    def read(self, timeout):
        import select
        if not select.select([self.fd], [], [], max(timeout, 0))[0]:
            return ""
        return os.read(self.fd, 256).decode("latin1")

    def name(self):
        """The tty's device name (/dev/pty0, /dev/cons0, ...), or ''."""
        try:
            return os.ttyname(self.fd)
        except OSError:
            return ""

    def size(self):
        """(rows, cols, xpixel, ypixel) of the window, or None."""
        try:
            import fcntl
            import struct
            return struct.unpack("HHHH", fcntl.ioctl(self.fd, self._termios.TIOCGWINSZ, b"\0" * 8))
        except Exception:
            return None

    def close(self):
        try:
            self._termios.tcflush(self.fd, self._termios.TCIFLUSH)
            self._termios.tcsetattr(self.fd, self._termios.TCSADRAIN, self._old)
        finally:
            os.close(self.fd)


class WindowsConsole(object):
    """CONIN$ / CONOUT$ with VT input and output on: the query goes out as text, the reply comes back as key events."""
    ENABLE_PROCESSED_OUTPUT, ENABLE_VT_PROCESSING = 0x1, 0x4
    ENABLE_VT_INPUT = 0x200
    KEY_EVENT = 0x1

    def __init__(self, vt_input=True):
        import ctypes
        from ctypes import wintypes
        self.vt_input = vt_input
        self.c = ctypes
        self.w = wintypes
        k = ctypes.WinDLL("kernel32", use_last_error=True)
        self.k = k
        k.CreateFileW.restype = wintypes.HANDLE
        k.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.c_void_p,
                                  wintypes.DWORD, wintypes.DWORD, wintypes.HANDLE]
        k.GetConsoleMode.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
        k.SetConsoleMode.argtypes = [wintypes.HANDLE, wintypes.DWORD]
        k.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
        k.WriteConsoleW.argtypes = [wintypes.HANDLE, wintypes.LPCWSTR, wintypes.DWORD,
                                    ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
        k.FlushConsoleInputBuffer.argtypes = [wintypes.HANDLE]
        k.CloseHandle.argtypes = [wintypes.HANDLE]

        class KeyEvent(ctypes.Structure):
            _fields_ = [("down", wintypes.BOOL), ("repeat", wintypes.WORD), ("vk", wintypes.WORD),
                        ("scan", wintypes.WORD), ("char", wintypes.WCHAR), ("state", wintypes.DWORD)]

        class Record(ctypes.Structure):
            class U(ctypes.Union):
                _fields_ = [("key", KeyEvent), ("pad", ctypes.c_byte * 16)]
            _anonymous_ = ("u",)
            _fields_ = [("type", wintypes.WORD), ("u", U)]

        class Info(ctypes.Structure):
            _fields_ = [("sx", wintypes.SHORT), ("sy", wintypes.SHORT), ("cx", wintypes.SHORT), ("cy", wintypes.SHORT),
                        ("attr", wintypes.WORD), ("left", wintypes.SHORT), ("top", wintypes.SHORT),
                        ("right", wintypes.SHORT), ("bottom", wintypes.SHORT), ("mx", wintypes.SHORT),
                        ("my", wintypes.SHORT)]

        self.Record, self.Info = Record, Info
        k.ReadConsoleInputW.argtypes = [wintypes.HANDLE, ctypes.POINTER(Record), wintypes.DWORD,
                                        ctypes.POINTER(wintypes.DWORD)]
        k.GetConsoleScreenBufferInfo.argtypes = [wintypes.HANDLE, ctypes.POINTER(Info)]
        bad = wintypes.HANDLE(-1).value
        share, openex = 3, 3
        self.hin = k.CreateFileW("CONIN$", 0xC0000000, share, None, openex, 0, None)
        self.hout = k.CreateFileW("CONOUT$", 0xC0000000, share, None, openex, 0, None)
        if self.hin in (None, bad) or self.hout in (None, bad):
            raise OSError("no console")
        self._old_in, self._old_out = wintypes.DWORD(), wintypes.DWORD()
        if not (k.GetConsoleMode(self.hin, ctypes.byref(self._old_in))
                and k.GetConsoleMode(self.hout, ctypes.byref(self._old_out))):
            raise OSError("not a console")
        k.SetConsoleMode(self.hin, self.ENABLE_VT_INPUT if self.vt_input else 0)   # no line input, no echo, no processing
        k.SetConsoleMode(self.hout, self._old_out.value | self.ENABLE_PROCESSED_OUTPUT | self.ENABLE_VT_PROCESSING)
        got = wintypes.DWORD()
        self.vt_out = bool(k.GetConsoleMode(self.hout, ctypes.byref(got)) and got.value & self.ENABLE_VT_PROCESSING)
        k.FlushConsoleInputBuffer(self.hin)

    def info(self):
        return ["Windows console: ENABLE_VIRTUAL_TERMINAL_PROCESSING %s" % (
            "accepted: conhost / ConPTY interpret the sequences below" if self.vt_out else
            "REFUSED (legacy console): ANSI.SYS-style sequences print as junk; only the Win32 console API works")]

    def write(self, text):
        n = self.w.DWORD()
        self.k.WriteConsoleW(self.hout, text, len(text), self.c.byref(n), None)

    def read(self, timeout):
        if self.k.WaitForSingleObject(self.hin, int(max(timeout, 0) * 1000)) != 0:
            return ""
        rec, n = self.Record(), self.w.DWORD()
        if not self.k.ReadConsoleInputW(self.hin, self.c.byref(rec), 1, self.c.byref(n)) or not n.value:
            return ""
        if rec.type == self.KEY_EVENT and rec.key.down and rec.key.char != "\0":
            return rec.key.char
        return ""                                                              # focus / mouse / resize: not a reply

    def name(self):
        return "Windows console (CONIN$/CONOUT$)"

    def size(self):
        info = self.Info()
        if not self.k.GetConsoleScreenBufferInfo(self.hout, self.c.byref(info)):
            return None
        return (info.bottom - info.top + 1, info.right - info.left + 1, 0, 0)

    def close(self):
        try:
            self.k.FlushConsoleInputBuffer(self.hin)
            self.k.SetConsoleMode(self.hin, self._old_in.value)
            self.k.SetConsoleMode(self.hout, self._old_out.value)
        finally:
            self.k.CloseHandle(self.hin)
            self.k.CloseHandle(self.hout)


def open_tty(vt_input=True):
    """The controlling terminal, or None.  vt_input=False (native Windows only) leaves ENABLE_VIRTUAL_TERMINAL_INPUT off."""
    try:
        return PosixTty() if os.name == "posix" else WindowsConsole(vt_input)
    except Exception:
        return None


def probe(tty, timeout):
    """Send every query in one burst and collect replies until all are in (plus GRACE, for a straggler or a second
    answer) or `timeout` passes.  Returns (text, seen) with seen[key] = seconds after sending of the first reply."""
    tty.write("".join(q.seq for q in QUERIES))
    t0 = time.time()
    text, seen, full = "", {}, None
    while time.time() - t0 < timeout:
        wait = t0 + timeout - time.time()
        if full is not None:
            wait = min(wait, full + GRACE - time.time())
            if wait <= 0:
                break
        chunk = tty.read(wait)
        if not chunk:
            continue
        text += chunk
        for q in QUERIES:
            if q.key not in seen and q.pat.search(text):
                seen[q.key] = time.time() - t0
        if full is None and len(seen) == len(QUERIES):
            full = time.time()
    return text, seen


def analyse(text, seen, size):
    """-> (rows, issues, notes): rows = [(query, dt or None, shown text, count)]; issues = [str] that make the
    negotiation verdict MANGLED; notes = [str] worth knowing that are not faults."""
    ctx = {"size": size}
    rows, issues, notes, rest = [], [], [], text
    for q in QUERIES:
        found = list(q.pat.finditer(text))
        rest = q.pat.sub("", rest)
        rows.append((q, seen.get(q.key), q.show(found[0], ctx) if found else None, len(found)))
        if len(found) > 1:
            issues.append("%s answered %d times: two layers both replied (the second lands on the TUI's screen)"
                          % (q.name, len(found)))
    rest = rest.strip()
    if rest:
        issues.append("%d byte(s) came back that are no known reply: %r - garbage that would land on a TUI's screen"
                      % (len(rest), rest))
    got = dict((q.key, m) for q, m in ((q, q.pat.search(text)) for q in QUERIES) if m)
    if "size18" in got and size and (int(got["size18"].group(1)), int(got["size18"].group(2))) != tuple(size[:2]):
        issues.append("CSI 18t says %sx%s but the window is %dx%d (stale or rewritten by an intermediary)"
                      % (got["size18"].group(2), got["size18"].group(1), size[1], size[0]))
    if "da1" not in got:
        issues.append("DA1 got no reply: a TUI that waits for it will stall")
    elif got["da1"].group(1) == "1;0":
        issues.append("DA1 is conhost's canned '1;0': the real terminal's capabilities are hidden from the program")
    if "mode9001" in got and got["mode9001"].group(1) in ("1", "3"):
        notes.append("win32-input-mode (9001) is on, as Windows Terminal / ConPTY normally have it: a program that "
                     "does not ask for the key records gets plain keys, and one that does (tvision) decodes them. "
                     "It only matters if they arrive damaged - test with --tvision")
    return rows, issues, notes


def environment():
    keys = ("TERM", "TERM_PROGRAM", "WT_SESSION", "MSYSTEM", "CYGWIN", "SSH_TERM_CONHOST_PARSER", "WSL_DISTRO_NAME",
            "SSH_CONNECTION", "SSH_TTY")
    return ", ".join("%s=%s" % (k, os.environ[k]) for k in keys if os.environ.get(k)) or "(no terminal variables set)"


def osc_verdict(seen, text):
    """-> (name, exit code)"""
    if "bg" in seen:
        return "ANSWERED", 0
    return ("DROPPED", 1) if seen or text else ("SILENT", 1)


CYGWIN_CONSOLE_HINT = (" This is Cygwin's own console (/dev/cons*), which swallows OSC queries on their way out: "
                       "run the program under wincygterm, in mintty, or over ssh instead.")


def report(label, rows, issues, seen, text, timeout, raw=False, size=None, notes=(), ttyname=""):
    out = ["termprobe%s" % (" [%s]" % label if label else ""),
           "  python:  %s %s, %s, os.name=%s" % (platform.python_implementation(), platform.python_version(),
                                                 platform.platform(), os.name),
           "  env:     %s" % environment()]
    if ttyname:
        out.append("  tty:     %s" % ttyname)
    if os.environ.get("WINCYGTERM"):
        out.append("  via:     wincygterm %s" % os.environ["WINCYGTERM"])
    if size:
        out.append("  window:  %d rows x %d cols%s" % (size[0], size[1], ", %dx%d px" % (size[2], size[3])
                                                       if size[2] and size[3] else ""))
    for q, dt, shown, count in rows:
        if shown is None:
            out.append("  %-34s no reply" % q.name)
        else:
            out.append("  %-34s %5.0f ms  %s%s" % (q.name, dt * 1000, shown, "   (x%d)" % count if count > 1 else ""))
    placed = sorted((q.pat.search(text).start(), q.key) for q in QUERIES if q.key in seen)
    asked = [q.key for q in QUERIES if q.key in seen]
    if [k for _, k in placed] != asked:
        out.append("  note: replies came back in a different order than asked: " + " -> ".join(k for _, k in placed))
    if raw:
        out.append("  raw bytes: %r" % text)
    name, code = osc_verdict(seen, text)
    why = {"ANSWERED": "the colour query round-trips on this path.",
           "DROPPED": "something answered but not the OSC colour query: the terminal ignores it, or an intermediary "
                      "(ConPTY, ssh, Cygwin's console layer, a multiplexer) ate it.",
           "SILENT": "no reply of any kind: the reply path may be dead, or every query was eaten."}[name]
    if name == "DROPPED" and ttyname.startswith("/dev/cons"):
        why += CYGWIN_CONSOLE_HINT
    out.append("  OSC 11:      %s - %s" % (name, why))
    if issues:
        out.append("  NEGOTIATION: MANGLED")
        out.extend("    - " + i for i in issues)
    else:
        out.append("  NEGOTIATION: CLEAN - every reply that came is whole, single and consistent.")
    out.extend("  note: " + n for n in notes)
    return "\n".join(out), (code or (1 if issues else 0))


TV_ON = ("\x1b[?1000h\x1b[?1002h\x1b[?1006h"                        # what tvision turns on (mouse; keys: below)
         "\x1b[?1036s\x1b[?1036h\x1b[?2004s\x1b[?2004h\x1b[>4;1m\x1b[>5u\x1b[?9001h")
TV_OFF = ("\x1b[?9001l\x1b[<u\x1b[>4m\x1b[?2004l\x1b[?2004r\x1b[?1036r"
          "\x1b[?1006l\x1b[?1002l\x1b[?1000l")
REC = re.compile(r"\x1b\[(\d+);(\d+);(\d+);([01]);(\d+);(\d+)_")           # win32-input-mode: Vk;Sc;Uc;Kd;Cs;Rc _
LEAK = re.compile(r"\[?\d+;\d+;\d+;[01];\d+;\d+_")                             # the same with its ESC eaten: shows on screen
VKEYS = {38: "\x1b[A", 40: "\x1b[B", 39: "\x1b[C", 37: "\x1b[D"}              # Up Down Right Left


def unwrap(text):
    """Decode win32-input-mode records the way tvision does: a key-down with a character is that character (this
    also unwraps the ESC [ < ... M of a mouse report that ConPTY wraps one record per byte), an arrow key is its CSI."""
    def one(m):
        vk, _, uc, down, _, rep = [int(g) for g in m.groups()]
        if not down:
            return ""
        return chr(uc) * max(rep, 1) if uc else VKEYS.get(vk, "")
    return REC.sub(one, text)


def input_test(tty, seconds=20.0, idle=4.0, tvision=False):
    """Ask for 10 letters, 3 clicks and the 4 arrow keys; -> (lines, ok).  With `tvision` the terminal is set up as
    tvision sets it up (win32-input-mode, kitty keys, modifyOtherKeys, mouse) and the records are decoded."""
    print("\nINPUT TEST%s: within %d s type  abcdefghij , click anywhere in this window 3 times, then press"
          "\n            Up Down Left Right  (in that order).  It ends %d s after you stop."
          % (" (tvision's setup)" if tvision else "", seconds, idle))
    sys.stdout.flush()
    tty.write(TV_ON if tvision else "\x1b[?1000h\x1b[?1006h")
    text, chunks, t0, last = "", [], time.time(), None
    try:
        while time.time() - t0 < seconds:
            wait = min(0.2, t0 + seconds - time.time())
            chunk = tty.read(wait)
            if chunk:
                text += chunk
                chunks.append((time.time(), chunk))
                last = time.time()
            elif last is not None and time.time() - last > idle:
                break
    finally:
        tty.write(TV_OFF if tvision else "\x1b[?1006l\x1b[?1000l")
    split = []                                                  # (tail, ms until the rest came): cut off at a read's end
    for i, (t, c) in enumerate(chunks):
        if re.search(r"\x1b(?:\[[0-9;<?>]*)?$", c):
            split.append((c[-12:], (chunks[i + 1][0] - t) * 1000 if i + 1 < len(chunks) else None))
    nrec, leaked = len(REC.findall(text)), len(LEAK.findall(REC.sub("", text)))
    if tvision:
        text = unwrap(text)
    mouse = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
    arrows = re.compile(r"\x1b[\[O]([ABCD])")
    w32 = re.compile(r"\x1b\[\d+;\d+;\d+;\d+;\d+;\d+_")
    clicks = [m for m in mouse.finditer(text) if int(m.group(1)) < 32]            # buttons, not motion or wheel
    press, release = [m for m in clicks if m.group(4) == "M"], [m for m in clicks if m.group(4) == "m"]
    ar = "".join(m.group(1) for m in arrows.finditer(text))
    rest = w32.sub("", arrows.sub("", mouse.sub("", text)))
    letters = "".join(c for c in rest if c.isalpha())
    junk = "".join(c for c in rest if not c.isalpha() and c not in "\r\n")
    lines, ok = [], True
    for what, got, want in (("letters", letters, "abcdefghij"), ("arrow keys", ar, "ABDC")):
        good = got == want
        ok = ok and good
        lines.append("  %-11s %s  (got %r, wanted %r%s)" % (what, "ok     " if good else "PROBLEM", got, want,
                                                             "; A=Up B=Down C=Right D=Left" if what == "arrow keys" else ""))
    good = len(press) >= 3 and len(release) >= 3
    ok = ok and good
    lines.append("  %-11s %s  (%d presses, %d releases, wanted 3 and 3)" % ("mouse", "ok     " if good else "PROBLEM",
                                                                           len(press), len(release)))
    if tvision:
        gaps = [g for _, g in split if g is not None]
        lines.append("  win32 records: %d whole, %d split across reads, %d leaked as text%s"
                     % (nrec, len(split), leaked, "" if not leaked else "  <- this is the garbage on a TUI's screen"))
        if split:
            lines.append("  split: the rest came after %s ms (e.g. %s); ncurses (tvision) waits only ESCDELAY, "
                         "default 10 ms, before it calls a lone ESC the Escape key"
                         % ("/".join("%.0f" % g for g in gaps[:8]) or "?", repr(split[0][0])))
        if split or leaked:
            ok = False
    elif w32.search(text):
        ok = False
        lines.append("  win32-input-mode records arrived (%d): the terminal is in win32-input-mode and the program "
                     "is not decoding it" % len(w32.findall(text)))
    if junk:
        ok = False
        lines.append("  stray bytes arrived: %r" % junk)
    if not text:
        lines.append("  (nothing was typed or clicked)")
        ok = False
    return lines, ok


# ---- DOS / ANSI.SYS screen control ---------------------------------------------------------------------------------
CPR_RE = re.compile(r"\x1b\[(\d+);(\d+)R")
DECRQSS_RE = re.compile(r"\x1bP([01])\$r(.*?)\x1b\\", re.S)
DOS_CORE = ("cup", "hvp", "home", "cuu", "cud", "cuf", "cub", "cu1", "scp")       # what ANSI.SYS itself could do
CP437_LOW = "☺☻♥♦♣♠•◘○◙♂♀♪♫☼►◄↕‼¶§▬↨↑↓→←∟↔▲▼"                       # 0x01-0x1F: control codes, glyphs on a PC
DOS2ANSI = (0, 4, 2, 6, 1, 5, 3, 7)                                            # DOS colour index -> ANSI (red/blue swap)
GROUP_TITLE = {
    "size": "Screen size", "cursor": "Cursor movement (ANSI.SYS: CUP HVP CUU CUD CUF CUB, SCP RCP, DSR)",
    "edge": "Cursor at the screen edge", "erase": "Erase", "wrap": "Line wrap",
    "sgr": "Colour and attributes, read back with DECRQSS (DOS attribute byte: 4-bit fg, 3-bit bg + blink)",
    "shape": "DOS cursor shape and visibility", "cp437": "CP437 glyphs: does each take exactly one column?",
}
# (key, label, SGR parameters)
SGR_TESTS = (
    ("bold", "bold / high intensity", "1"), ("ul", "underline", "4"), ("blink", "blink", "5"),
    ("rev", "reverse video", "7"), ("conceal", "conceal", "8"),
    ("fg16", "foreground 30-37", "31"), ("bg16", "background 40-47", "44"),
    ("fgb", "bright foreground 90-97", "91"), ("bgb", "bright background 100-107", "104"),
    ("dos1f", "DOS 0x1F: bright white on blue", "1;37;44"),
    ("c256", "256 colours", "38;5;208"), ("rgb", "true colour", "38;2;255;128;0"),
)


def cp437_glyph(b):
    """The character a PC shows for byte `b` (0x01-0x1F and 0x7F are glyphs there, not control codes)."""
    if b == 0:
        return " "
    if b < 32:
        return CP437_LOW[b - 1]
    return "⌂" if b == 127 else bytes(bytearray([b])).decode("cp437")


class Screen(object):
    """Send a sequence, then ask where the cursor is: the answer is a position, so there is nothing to eyeball."""
    def __init__(self, tty, timeout):
        self.tty, self.timeout, self.buf = tty, timeout, ""

    def send(self, text):
        self.tty.write(text)

    def wait(self, pat, timeout):
        end = time.time() + timeout
        while True:
            m = pat.search(self.buf)
            if m:
                self.buf = self.buf[m.end():]
                return m
            left = end - time.time()
            if left <= 0:
                self.buf = ""
                return None
            self.buf += self.tty.read(left)

    def ask(self, seq, pat, timeout):
        self.send(seq)
        return self.wait(pat, timeout)

    def cpr(self):
        m = self.ask("\x1b[6n", CPR_RE, self.timeout)
        return (int(m.group(1)), int(m.group(2))) if m else None

    def mode(self, n):
        m = self.ask("\x1b[?%d$p" % n, re.compile(r"\x1b\[\?%d;(\d)\$y" % n), self.timeout)
        return int(m.group(1)) if m else None


def _pos(p):
    return "row %d, col %d" % p


def cursor_tests(rows, cols):
    """(group, key, name, sequence, {position: note}) - every listed position counts as a pass."""
    sys_note = "not supported here; only real ANSI.SYS and DOS emulators take it"
    return (
        ("cursor", "cup", "CUP  ESC[5;10H", "\x1b[1;1H\x1b[5;10H", {(5, 10): ""}),
        ("cursor", "hvp", "HVP  ESC[6;12f", "\x1b[1;1H\x1b[6;12f", {(6, 12): ""}),
        ("cursor", "home", "CUP  ESC[H (home), default parameters", "\x1b[7;7H\x1b[H", {(1, 1): ""}),
        ("cursor", "cuu", "CUU  ESC[3A", "\x1b[10;10H\x1b[3A", {(7, 10): ""}),
        ("cursor", "cud", "CUD  ESC[2B", "\x1b[10;10H\x1b[2B", {(12, 10): ""}),
        ("cursor", "cuf", "CUF  ESC[4C", "\x1b[10;10H\x1b[4C", {(10, 14): ""}),
        ("cursor", "cub", "CUB  ESC[5D", "\x1b[10;10H\x1b[5D", {(10, 5): ""}),
        ("cursor", "cu1", "CUU CUD CUD CUF CUB CUB with no number (= 1)",
         "\x1b[10;10H\x1b[A\x1b[B\x1b[B\x1b[C\x1b[D\x1b[D", {(11, 9): ""}),
        ("cursor", "scp", "SCP / RCP  ESC[s ... ESC[u  (ANSI.SYS)", "\x1b[4;8H\x1b[s\x1b[9;2H\x1b[u", {(4, 8): ""}),
        ("cursor", "decsc", "DECSC / DECRC  ESC7 ... ESC8  (VT100)", "\x1b[4;8H\x1b7\x1b[9;2H\x1b8", {(4, 8): ""}),
        ("cursor", "cnl", "CNL  ESC[2E (next line; ANSI, not ANSI.SYS)", "\x1b[5;9H\x1b[2E", {(7, 1): ""}),
        ("cursor", "cha", "CHA  ESC[12G (column)", "\x1b[5;9H\x1b[12G", {(5, 12): ""}),
        ("cursor", "vpa", "VPA  ESC[8d (row)", "\x1b[5;9H\x1b[8d", {(8, 9): ""}),
        ("edge", "clamp_up", "CUU  ESC[9A from row 3", "\x1b[3;3H\x1b[9A",
         {(1, 3): "stops at the top edge", (3, 3): "ignored, as the ANSI.SYS manual says"}),
        ("edge", "clamp_dn", "CUD  ESC[999B from row 3", "\x1b[3;3H\x1b[999B",
         {(rows, 3): "stops at the bottom edge", (3, 3): "ignored, as the ANSI.SYS manual says"}),
        ("edge", "clamp_lt", "CUB  ESC[99D from column 3", "\x1b[3;3H\x1b[99D",
         {(3, 1): "stops at the left edge", (3, 3): "ignored, as the ANSI.SYS manual says"}),
        ("edge", "clamp_rt", "CUF  ESC[999C from column 3", "\x1b[3;3H\x1b[999C",
         {(3, cols): "stops at the right edge", (3, 3): "ignored, as the ANSI.SYS manual says"}),
        ("erase", "ed2", "ED   ESC[2J, where the cursor ends up", "\x1b[5;5H\x1b[2J",
         {(1, 1): "homes the cursor, as ANSI.SYS does", (5, 5): "leaves the cursor, as VT100 / xterm do"}),
        ("wrap", "wrap_on", "DECAWM  ESC[?7h: text wraps at the last column", "\x1b[?7h\x1b[2;%dHab" % cols, {(3, 2): ""}),
        ("wrap", "wrap_off", "DECAWM  ESC[?7l: text stays on the last column", "\x1b[?7l\x1b[2;%dHab" % cols,
         {(2, cols): ""}),
        ("wrap", "wrap_sys_on", "ANSI.SYS  ESC[=7h: enable line wrap", "\x1b[?7l\x1b[=7h\x1b[2;%dHab" % cols, {(3, 2): ""}),
        ("wrap", "wrap_sys_off", "ANSI.SYS  ESC[=7l: disable line wrap", "\x1b[?7h\x1b[=7l\x1b[2;%dHab" % cols,
         {(2, cols): ""}),
    ), sys_note


def dos_screen(tty, timeout):
    """-> (results, status, alt).  results = [(group, key, name, 'ok'|'DIFFERS'|'no reply'|'skipped', detail)];
    status is None, or 'cpr' when the terminal never answered ESC[6n (nothing can be measured)."""
    scr, res, qt = Screen(tty, timeout), [], min(timeout, 0.7)
    m = scr.ask("\x1b[?1049$p", re.compile(r"\x1b\[\?1049;(\d)\$y"), qt)
    alt = bool(m) and m.group(1) != "0"
    try:
        scr.send(("\x1b[?1049h" if alt else "") + "\x1b[0m\x1b[?7h\x1b[2J\x1b[999;999H")
        ext = scr.cpr()
        if ext is None:
            return res, "cpr", alt
        rows, cols = ext
        size = tty.size()
        note = "   <- the window is %dx%d" % (size[1], size[0]) if size and tuple(size[:2]) != ext else ""
        res.append(("size", "extent", "Screen extent, measured with ESC[999;999H", "ok", "%d rows x %d cols%s" % (rows, cols, note)))
        fits = rows >= 25 and cols >= 80
        res.append(("size", "dos80x25", "Room for the DOS 80x25 text screen", "ok" if fits else "DIFFERS",
                    "" if fits else "the window is smaller: DOS-style full-screen programs will not fit"))
        if rows < 14 or cols < 40:
            res.append(("cursor", "small", "Cursor tests", "skipped", "window too small (need 14 rows x 40 cols)"))
            return res, None, alt
        tests, sys_note = cursor_tests(rows, cols)
        for group, key, name, seq, expect in tests:
            scr.send(seq)
            pos = scr.cpr()
            if pos is None:
                res.append((group, key, name, "no reply", ""))
            elif pos in expect:
                res.append((group, key, name, "ok", _pos(pos) + ("   (%s)" % expect[pos] if expect[pos] else "")))
            else:
                detail = "%s; wanted %s" % (_pos(pos), " or ".join(_pos(p) for p in expect))
                if key.startswith("wrap_sys"):
                    detail = "%s - %s" % (_pos(pos), sys_note)
                res.append((group, key, name, "DIFFERS", detail))
        scr.send("\x1b[?7h\x1b[0m")
        # attributes, read back with DECRQSS
        asked = True
        for key, label, params in SGR_TESTS:
            name = "SGR %s  %s" % (params, label)
            if not asked:
                res.append(("sgr", "sgr_" + key, name, "skipped", "DECRQSS got no answer"))
                continue
            m = scr.ask("\x1b[0m\x1b[%sm\x1bP$qm\x1b\\" % params, DECRQSS_RE, qt)
            scr.send("\x1b[0m")
            if m is None or m.group(1) != "1":
                asked = False
                res.append(("sgr", "sgr_" + key, name, "no reply", "no DECRQSS: look at the picture below instead"))
                continue
            got = [t for t in re.split(r"[;:]", m.group(2).rstrip("m")) if t]
            want = params.split(";")
            hit = any(got[i:i + len(want)] == want for i in range(len(got) - len(want) + 1))
            res.append(("sgr", "sgr_" + key, name, "ok" if hit else "DIFFERS", "read back %s" % ";".join(got)))
        # cursor shape (DOS: INT 10h cursor start/end lines) and visibility
        for n, label in ((3, "underline (the DOS cursor)"), (2, "steady block")):
            m = scr.ask("\x1b[%d q\x1bP$q q\x1b\\" % n, DECRQSS_RE, qt)
            ok = bool(m) and m.group(1) == "1" and m.group(2).strip() == "%d q" % n
            res.append(("shape", "shape%d" % n, "DECSCUSR  ESC[%d SP q  %s" % (n, label),
                        "ok" if ok else ("DIFFERS" if m else "no reply"), "" if ok or not m else "read back %r" % m.group(2)))
        scr.send("\x1b[?25l")
        hidden = scr.mode(25)
        scr.send("\x1b[?25h")
        shown = scr.mode(25)
        ok = hidden in (2, 4) and shown in (1, 3)
        res.append(("shape", "vis", "Hide / show cursor  ESC[?25l / ESC[?25h", "ok" if ok else
                    ("no reply" if hidden is None else "DIFFERS"), "" if ok else "DECRQM said %s then %s" % (hidden, shown)))
        # CP437: every glyph must take one column, or a DOS screen layout falls apart
        rows437 = [("0x01-0x1F, 0x7F", CP437_LOW + "⌂")] + [
            ("0x%02X-0x%02X" % (b, b + 15), "".join(cp437_glyph(c) for c in range(b, b + 16))) for b in range(0x80, 0x100, 16)]
        for i, (label, chars) in enumerate(rows437):
            scr.send("\x1b[3;1H\x1b[K" + chars)
            pos = scr.cpr()
            name = "CP437 %s" % label
            if pos == (3, 1 + len(chars)):
                res.append(("cp437", "cp437_%d" % i, name, "ok", "%d glyphs, %d columns" % (len(chars), len(chars))))
                continue
            if pos is None:
                res.append(("cp437", "cp437_%d" % i, name, "no reply", ""))
                continue
            odd = []
            for ch in chars:
                scr.send("\x1b[3;1H" + ch)
                p = scr.cpr()
                d = p[1] - 1 if p and p[0] == 3 else None
                if d != 1:
                    odd.append("U+%04X %s=%s" % (ord(ch), ch, "?" if d is None else "%d col" % d))
            res.append(("cp437", "cp437_%d" % i, name, "DIFFERS", "%s" % ", ".join(odd[:10] + (["..."] if len(odd) > 10 else []))))
        return res, None, alt
    finally:
        scr.send("\x1b[0m\x1b[0 q\x1b[?25h\x1b[?7h" + ("\x1b[?1049l" if alt else ""))


def dos_verdicts(res, status):
    """-> [(kind, text)], kind being ok / warn / info."""
    if status == "cpr":
        return [("warn", "ANSI.SYS CORE: UNTESTED - ESC[6n (device status report) got no reply, so there is nothing "
                         "to measure with")]
    by = dict((r[1], r) for r in res)
    out = []
    core = [by[k] for k in DOS_CORE if k in by]
    if core:
        n = sum(1 for r in core if r[3] == "ok")
        word = "FULL" if n == len(core) else "MISSING" if n == 0 else "PARTIAL"
        out.append(("ok" if word == "FULL" else "warn",
                    "ANSI.SYS CORE: %s - %d of %d cursor sequences (CUP HVP CUU CUD CUF CUB SCP) landed where DOS would "
                    "put it" % (word, n, len(core))))
    sgr = [(k, l) for k, l, _ in SGR_TESTS if "sgr_" + k in by]
    if sgr:
        if any(by["sgr_" + k][3] in ("ok", "DIFFERS") for k, _ in sgr):
            okl = [l for k, l in sgr if by["sgr_" + k][3] == "ok"]
            bad = [l for k, l in sgr if by["sgr_" + k][3] not in ("ok",)]
            out.append(("warn" if bad else "ok", "ATTRIBUTES: confirmed %s%s" % (
                ", ".join(okl) or "none", "; not confirmed: " + ", ".join(bad) if bad else "")))
        else:
            out.append(("info", "ATTRIBUTES: UNKNOWN - the terminal does not answer DECRQSS; judge by the picture"))
    cp = [r for r in res if r[0] == "cp437"]
    if cp:
        bad = [r for r in cp if r[3] != "ok"]
        out.append(("warn" if bad else "ok", "CP437: %s" % (
            "all 256 glyphs are one column wide" if not bad else
            "%d of %d rows have glyphs that are not one column wide (see above)" % (len(bad), len(cp)))))
    return out


def dos_findings(res, status):
    """The --dos part of the SUMMARY: the verdicts plus the single facts worth a line."""
    f = list(dos_verdicts(res, status))
    by = dict((r[1], r) for r in res)

    def st(k):
        return by[k][3] if k in by else None

    if st("dos80x25"):
        fits = st("dos80x25") == "ok"
        f.append(("ok" if fits else "warn", "Window %s the DOS 80x25 text screen (%s)"
                  % ("holds" if fits else "is smaller than", by["extent"][4].split("   <-")[0])))
    if st("wrap_on"):
        both = st("wrap_on") == "ok" and st("wrap_off") == "ok"
        f.append(("ok" if both else "warn", "Line wrap on / off (DECAWM, ESC[?7h/l) %s" % ("works" if both else "does not behave")))
        sysok = st("wrap_sys_on") == "ok" and st("wrap_sys_off") == "ok"
        f.append(("ok" if sysok else "info", "ANSI.SYS wrap mode ESC[=7h/l %s" % (
            "works" if sysok else "is not supported (only real ANSI.SYS and DOS emulators take it)")))
    if st("ed2"):
        detail = by["ed2"][4]
        f.append(("info", "ESC[2J " + (detail.split("(")[-1].rstrip(")") if "(" in detail else detail)))
    edges = [k for k in ("clamp_up", "clamp_dn", "clamp_lt", "clamp_rt") if st(k)]
    if edges:
        bad = [k for k in edges if st(k) != "ok"]
        f.append(("warn" if bad else "ok", "Cursor movement at the screen edges %s" % ("is wrong" if bad else "stops or is ignored, as DOS")))
    shape = [k for k in ("shape3", "shape2", "vis") if st(k)]
    if shape:
        bad = [k for k in shape if st(k) != "ok"]
        f.append(("ok" if not bad else "info", "DOS cursor shape (underline / block) and hide / show %s" % (
            "work" if not bad else "not confirmed: " + ", ".join(bad))))
    return f


def dos_report(res, status, alt, info):
    out = ["", "DOS / ANSI.SYS SCREEN CONTROL",
           "  (positions are measured with ESC[6n; under ConPTY some answers come from ConPTY itself, not the terminal)"]
    out.extend("  " + i for i in info)
    out.append("  ran on the %s" % ("alternate screen (restored afterwards)" if alt else
                                    "main screen: this terminal has no alternate screen, so the top of it was overwritten"))
    last = None
    for group, key, name, st, detail in res:
        if group != last:
            out.append("  [%s]" % GROUP_TITLE[group])
            last = group
        out.append("    %-52s %-8s %s" % (name, st, detail))
    out.extend("  " + t for _, t in dos_verdicts(res, status))
    out.append("  not testable from the terminal side: direct video RAM (B800:0000) and BIOS INT 10h, which do not exist on a")
    out.append("  pty; Win32 console output calls (SetConsoleCursorPosition etc.), which ConPTY turns into the sequences above")
    out.append("  (console mouse events are tested separately, below);")
    out.append("  ANSI.SYS key reassignment ESC[..p and screen mode ESC[=nh, left alone because they change terminal state.")
    return "\n".join(out)


# ---- the mouse, two ways: escape-sequence reports and console (conhost) events -----------------------------------
SGR_MOUSE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")


def vt_mouse_test(tty, seconds=8.0):
    """The mouse as tvision / ncurses / vim ask for it: SGR reports (ESC[?1000h ESC[?1006h).  -> (presses, releases)"""
    tty.write("\x1b[?1000h\x1b[?1006h")
    text, t0 = "", time.time()
    try:
        while time.time() - t0 < seconds:
            text += tty.read(max(min(0.2, t0 + seconds - time.time()), 0))
            ev = [m for m in SGR_MOUSE.finditer(unwrap(text)) if int(m.group(1)) < 32]     # buttons, not motion / wheel
            if sum(1 for m in ev if m.group(4) == "M") >= 3 and sum(1 for m in ev if m.group(4) == "m") >= 3:
                break
    finally:
        tty.write("\x1b[?1006l\x1b[?1000l")
    ev = [m for m in SGR_MOUSE.finditer(unwrap(text)) if int(m.group(1)) < 32]
    return sum(1 for m in ev if m.group(4) == "M"), sum(1 for m in ev if m.group(4) == "m")


def win_mouse_test(seconds=8.0):
    """Native Windows only: the mouse as a console program reads it, MOUSE_EVENT records after ENABLE_MOUSE_INPUT
    (virtual-terminal input off, quick-edit off).  -> dict(press, release, move, wheel, keys), or None without a console."""
    import ctypes
    from ctypes import wintypes as wt

    class COORD(ctypes.Structure):
        _fields_ = [("X", wt.SHORT), ("Y", wt.SHORT)]

    class MOUSE(ctypes.Structure):
        _fields_ = [("pos", COORD), ("buttons", wt.DWORD), ("ctrl", wt.DWORD), ("flags", wt.DWORD)]

    class KEY(ctypes.Structure):
        _fields_ = [("down", wt.BOOL), ("repeat", wt.WORD), ("vk", wt.WORD), ("scan", wt.WORD),
                    ("char", wt.WCHAR), ("state", wt.DWORD)]

    class RECORD(ctypes.Structure):
        class U(ctypes.Union):
            _fields_ = [("key", KEY), ("mouse", MOUSE), ("pad", ctypes.c_byte * 16)]
        _anonymous_ = ("u",)
        _fields_ = [("type", wt.WORD), ("u", U)]

    k = ctypes.WinDLL("kernel32", use_last_error=True)
    H = wt.HANDLE
    k.CreateFileW.restype = H
    k.CreateFileW.argtypes = [wt.LPCWSTR, wt.DWORD, wt.DWORD, ctypes.c_void_p, wt.DWORD, wt.DWORD, H]
    k.GetConsoleMode.argtypes = [H, ctypes.POINTER(wt.DWORD)]
    k.SetConsoleMode.argtypes = [H, wt.DWORD]
    k.WaitForSingleObject.argtypes = [H, wt.DWORD]
    k.ReadConsoleInputW.argtypes = [H, ctypes.POINTER(RECORD), wt.DWORD, ctypes.POINTER(wt.DWORD)]
    k.FlushConsoleInputBuffer.argtypes = [H]
    k.CloseHandle.argtypes = [H]
    hin = k.CreateFileW("CONIN$", 0xC0000000, 3, None, 3, 0, None)
    old = wt.DWORD()
    if hin in (None, H(-1).value) or not k.GetConsoleMode(hin, ctypes.byref(old)):
        return None
    res = dict(press=0, release=0, move=0, wheel=0, keys=0)
    down, recs, n, t0 = False, (RECORD * 16)(), wt.DWORD(), time.time()
    k.SetConsoleMode(hin, 0x80 | 0x10 | 0x08)          # EXTENDED_FLAGS (quick-edit off) | MOUSE_INPUT | WINDOW_INPUT
    k.FlushConsoleInputBuffer(hin)
    try:
        while time.time() - t0 < seconds and not (res["press"] >= 3 and res["release"] >= 3):
            if k.WaitForSingleObject(hin, 200) != 0:
                continue
            if not k.ReadConsoleInputW(hin, recs, 16, ctypes.byref(n)):
                break
            for i in range(n.value):
                r = recs[i]
                if r.type == 2:
                    flags, buttons = r.mouse.flags, r.mouse.buttons & 0xFFFF
                    if flags & 0xC:
                        res["wheel"] += 1
                        continue
                    res["move"] += 1 if flags & 0x1 else 0
                    if buttons and not down:
                        res["press"], down = res["press"] + 1, True
                    elif not buttons and down:
                        res["release"], down = res["release"] + 1, False
                elif r.type == 1 and r.key.down:
                    res["keys"] += 1
    finally:
        k.SetConsoleMode(hin, old.value)
        k.FlushConsoleInputBuffer(hin)
        k.CloseHandle(hin)
    return res


def win_mouse_run(seconds):
    """Prompt, run win_mouse_test, print what came.  -> status: ok | none | partial | error"""
    print("  Console mouse events (what Microsoft Edit and other Windows-API programs read): click 3 times in this "
          "window within %d s ..." % seconds)
    sys.stdout.flush()
    res = win_mouse_test(seconds)
    if res is None:
        print("  no console to read mouse events from")
        return "error"
    print("  got %(press)d presses, %(release)d releases, %(move)d moves, %(wheel)d wheel, %(keys)d key events" % res)
    return "ok" if res["press"] >= 3 and res["release"] >= 3 else "partial" if res["press"] or res["release"] else "none"


def native_python():
    """A native Windows Python for a Cygwin / MSYS run: py, python.exe, python3.exe - the first that says os.name == 'nt'."""
    for name in ("py", "python.exe", "python3.exe"):
        exe = shutil.which(name)
        if exe and subprocess.call([exe, "-c", "import os, sys; sys.exit(0 if os.name == 'nt' else 1)"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
            return exe
    return None


def conhost_mouse(seconds):
    """-> status: ok | none | partial | error | na.  Under Cygwin / MSYS a native Windows Python is started from the
    shell: that is what 'a Windows console program started from here' means, pseudo console and all."""
    if os.name == "nt":
        return win_mouse_run(seconds)
    if sys.platform not in ("cygwin", "msys"):
        return "na"
    py = native_python()
    if not py:
        print("  no native Windows Python (py, python.exe) on PATH: cannot start a Windows console program from here")
        return "na"
    try:
        script = subprocess.check_output(["cygpath", "-w", os.path.realpath(__file__)]).decode("utf-8", "replace").strip()
    except (OSError, subprocess.CalledProcessError):
        print("  cannot turn this script's path into a Windows path (no cygpath)")
        return "na"
    sys.stdout.flush()
    code = subprocess.call([py, script, "--win-mouse", str(seconds)])
    return {0: "ok", 1: "none", 3: "partial"}.get(code, "error")


def mouse_section(tty, seconds=8.0):
    """Both mice, one after the other; prints as it goes.  -> [(kind, text)] for the SUMMARY."""
    print("\nMOUSE")
    print("  Escape-sequence mouse (xterm SGR: tvision, ncurses, vim): click 3 times in this window within %d s ..." % seconds)
    sys.stdout.flush()
    press, release = vt_mouse_test(tty, seconds)
    print("  got %d presses, %d releases" % (press, release))
    vt_ok = press >= 3 and release >= 3
    status = conhost_mouse(seconds)
    f = [("ok" if vt_ok else "warn",
          "Mouse as escape sequences (tvision, ncurses, vim): %s" % (
              "works (%d presses, %d releases)" % (press, release) if vt_ok else
              "%d presses / %d releases - missing; nobody clicked, or this path drops the reports" % (press, release)))]
    if status == "ok":
        f.append(("ok", "Mouse as console events (conhost ENABLE_MOUSE_INPUT; Microsoft Edit, Windows-API programs): works"))
    elif status in ("none", "partial"):
        hint = ""
        if vt_ok:
            hint = ": escape-sequence mouse works but console mouse events do not, so this path carries text only"
        if os.environ.get("WINCYGTERM"):
            hint += "; under wincygterm start such a program with `wcdirect PROG`"
        f.append(("warn", "Mouse as console events (Microsoft Edit, Windows-API programs): %s%s" % (
            "none arrived" if status == "none" else "only some arrived", hint)))
    elif status == "error":
        f.append(("warn", "Mouse as console events: the test could not run"))
    else:
        f.append(("info", "Mouse as console events: not testable here (needs Windows, and a native Windows Python under Cygwin)"))
    return f


# ---- the SUMMARY ------------------------------------------------------------------------------------------------
TAGS = {"ok": "[ ok ]", "warn": "[warn]", "fail": "[FAIL]", "info": "[info]"}
MODE_LABELS = (("mode1000", "mouse"), ("mode1006", "SGR mouse"), ("mode2004", "bracketed paste"),
               ("mode2026", "synchronized output"), ("mode9001", "win32-input-mode"))


def base_findings(rows, issues, notes, seen, text, ttyname):
    """The negotiation part of the SUMMARY, from what analyse() and report() already know."""
    f = []
    name, _ = osc_verdict(seen, text)
    if name == "ANSWERED":
        f.append(("ok", "Colour query (OSC 10/11) answered: programs can learn the terminal's colours"))
    else:
        why = ("something answered but not the colour query (ignored, or eaten by an intermediary)" if name == "DROPPED"
               else "no reply of any kind")
        if name == "DROPPED" and ttyname.startswith("/dev/cons"):
            why += "." + CYGWIN_CONSOLE_HINT.rstrip(".")
        f.append(("fail", "Colour query (OSC 10/11) %s: %s" % (name, why)))
    if issues:
        f.append(("fail", "Negotiation MANGLED: %d problem(s)" % len(issues)))
        f.extend(("fail", "  " + i) for i in issues)
    else:
        f.append(("ok", "Negotiation clean: every reply whole, single and consistent"))
    shown = dict((q.key, s) for q, dt, s, c in rows if s is not None)
    ident = ["%s %s" % (label, shown[k]) for k, label in (("xtver", "XTVERSION"), ("da2", "DA2"), ("da1", "DA1")) if k in shown]
    f.append(("info", "Terminal says: " + "; ".join(ident)) if ident else
             ("warn", "The terminal did not identify itself (no XTVERSION, DA2 or DA1 reply)"))
    f.append(("info", "Modes (DECRQM): " + ", ".join("%s %s" % (label, shown.get(k, "no reply")) for k, label in MODE_LABELS)))
    keys = [s for s in ("kitty keyboard " + shown["kitty"] if "kitty" in shown else None,
                        "modifyOtherKeys " + shown["modkeys"] if "modkeys" in shown else None) if s]
    f.append(("info", "Key protocols: " + (", ".join(keys) if keys else "no kitty keyboard or modifyOtherKeys reply")))
    silent = [q.name for q, dt, s, c in rows if s is None]
    if silent:
        f.append(("info", "No reply to: " + ", ".join(silent)))
    f.extend(("info", n) for n in notes)
    return f


def input_findings(lines, ok, tvision):
    f = [("ok" if ok else "fail", "Keyboard and mouse fidelity%s: %s" % (" under tvision's setup" if tvision else "",
                                                                          "clean" if ok else "PROBLEM"))]
    for line in lines:
        s = line.strip()
        if "PROBLEM" in s or "stray" in s or s.startswith("split") or "records arrived" in s or "nothing was typed" in s:
            f.append(("fail", "  " + s))
        elif s.startswith("win32 records"):
            f.append(("info", "  " + s))
    return f


def print_summary(findings):
    print("\nSUMMARY")
    for kind, text in findings:
        indent = text[:len(text) - len(text.lstrip())]
        print(textwrap.fill(text.strip(), width=118, initial_indent="  %s %s" % (TAGS[kind], indent),
                            subsequent_indent=" " * 9 + indent))
    fails = sum(1 for k, _ in findings if k == "fail")
    warns = sum(1 for k, _ in findings if k == "warn")
    print("  %d failure(s), %d warning(s)" % (fails, warns))


def visual(tty):
    """Draw what cannot be measured; each line says what you should see."""
    def c(codes, text):
        return "\x1b[%sm%s\x1b[0m" % (codes, text)
    L = ["", "DOS / ANSI.SYS VISUAL CHECK - each line says what you should see", "",
         "foreground 30-37 : " + "".join(c(30 + i, "██ ") for i in range(8)) + "  (black is invisible on a black screen)",
         "bright fg   90-97 : " + "".join(c(90 + i, "██ ") for i in range(8)),
         "background 40-47 : " + "".join(c(40 + i, "   ") + " " for i in range(8)),
         "bright bg  100-107: " + "".join(c(100 + i, "   ") + " " for i in range(8)),
         "attributes: " + c(1, "bold") + " " + c(4, "underline") + " " + c(5, "blink") + " " + c(7, "reverse")
         + "   conceal: [" + c(8, "SECRET") + "] (the brackets should look empty)",
         "EL  ESC[K : should read just OK :  XXXXXX\x1b[6D\x1b[KOK",
         "DEC line drawing ESC(0 (a small box):", "    \x1b(0lqqqk\x1b(B", "    \x1b(0x   x\x1b(B", "    \x1b(0mqqqj\x1b(B", "",
         "The 256 DOS attribute bytes: row = background 0-F, column = foreground 0-F, cell text is background+foreground.",
         "On a DOS screen background 8-F would blink instead of being bright:"]
    for bg in range(16):
        cells = []
        for fg in range(16):
            f = (30 if fg < 8 else 90) + DOS2ANSI[fg & 7]
            b = (40 if bg < 8 else 100) + DOS2ANSI[bg & 7]
            cells.append("\x1b[%d;%dm%X%X " % (f, b, bg, fg))
        L.append("".join(cells) + "\x1b[0m")
    L += ["", "CP437 as Unicode: every row should end with | in the same column; a ragged edge is a glyph of the wrong width.",
          "    " + " ".join("%X" % i for i in range(16)) + "  |"]
    for r in range(16):
        L.append(" %X_ " % r + " ".join(cp437_glyph(r * 16 + col) for col in range(16)) + "  |")
    tty.write("\r\n".join(L) + "\r\n")


def main(argv=None):
    ap = argparse.ArgumentParser(description="What survives the trip between a program and its terminal?")
    ap.add_argument("--timeout", type=float, default=2.0, help="seconds to wait for the replies (default 2.0)")
    ap.add_argument("--label", default="", help="a name for this run, to tell the outputs apart")
    ap.add_argument("--raw", action="store_true", help="also show every byte that came back")
    ap.add_argument("--input", action="store_true", help="also test keyboard and mouse fidelity (interactive)")
    ap.add_argument("--tvision", action="store_true",
                    help="like --input, but first set the terminal up as tvision does (win32-input-mode, kitty keys, "
                         "modifyOtherKeys) and decode the key records: reproduces tvmail's input problems")
    ap.add_argument("--dos", action="store_true",
                    help="also test classic DOS / ANSI.SYS screen control: cursor, erase, wrap, 16 colours, blink, "
                         "cursor shape, CP437 glyph widths (cursor behaviour is measured with ESC[6n)")
    ap.add_argument("--no-visual", action="store_true", help="with --dos: skip the colour / CP437 picture at the end")
    ap.add_argument("--no-mouse", action="store_true", help="with --dos: skip the interactive mouse tests (no clicking)")
    ap.add_argument("--no-vt-input", action="store_true",
                    help="native Windows only: do not set ENABLE_VIRTUAL_TERMINAL_INPUT (how a program that reads key events sees it)")
    ap.add_argument("--win-mouse", type=float, metavar="S", help=argparse.SUPPRESS)    # internal: the native-Windows child
    args = ap.parse_args(argv)
    if args.win_mouse:
        if os.name != "nt":
            return 2
        return {"ok": 0, "none": 1, "error": 2, "partial": 3}[win_mouse_run(args.win_mouse)]
    tty = open_tty(not args.no_vt_input)
    if tty is None:
        print("termprobe: NO TTY - there is no terminal to ask (is this a pipe, cron, or a Windows Python run "
              "from a pty such as mintty? run it from a Cygwin/MSYS Python there instead)", file=sys.stderr)
        return 2
    try:
        size = tty.size()
        text, seen = probe(tty, args.timeout)
        rows, issues, notes = analyse(text, seen, size)
        msg, code = report(args.label, rows, issues, seen, text, args.timeout, args.raw, size, notes, tty.name())
        print(msg)
        findings = base_findings(rows, issues, notes, seen, text, tty.name())
        if args.dos:
            res, status, alt = dos_screen(tty, args.timeout)
            enc = getattr(sys.stdout, "encoding", None) or "ascii"
            print(dos_report(res, status, alt, tty.info()).encode(enc, "replace").decode(enc))   # glyphs a pipe can't carry
            sys.stdout.flush()
            findings += dos_findings(res, status)
            if not args.no_mouse:
                findings += mouse_section(tty)
            if not args.no_visual:
                visual(tty)
        if args.input or args.tvision:
            lines, ok = input_test(tty, tvision=args.tvision)
            print("\n".join(lines))
            print("  INPUT:       %s" % ("CLEAN" if ok else "PROBLEM"))
            code = code or (0 if ok else 1)
            findings += input_findings(lines, ok, args.tvision)
        sys.stdout.flush()
        print_summary(findings)
    finally:
        tty.close()
    return code


if __name__ == "__main__":
    sys.exit(main())
