#!/usr/bin/env bash
# fixperms - repair the owner, group, mode and ACL of files and directories
# that were created from an elevated (Run as administrator) Cygwin shell and
# that a normal, non-elevated session then cannot read or write.
#
# For every path it:
#   1. sets the owner and group to the invoking user (or --user / --group);
#   2. replaces the ACL with a minimal, inheritable POSIX ACL
#      (setfacl -s: directories u::rwx,g::r-x,o::r-x plus the same as default
#      entries; files u::rw-,g::r--,o::r--; executables keep x for everyone),
#      which drops the named-user/group entries, mask and deny ACEs that show
#      up as a trailing '+' in ls -l;
#   3. falls back to "icacls /reset" + chmod for anything setfacl cannot set.
#
# Places that need other modes or owners (~/.ssh, ~/.gnupg, credential files,
# /var/mail, /tmp, sshd's host keys, other users' homes) are handled by a rule
# table: see BUILTIN_RULES below, --list-rules, and the user rules file.
#
# A file counts as executable if any x bit was set or it starts with "#!",
# "MZ" (a Windows exe/dll, which Cygwin needs x on to load) or "\177ELF".
#
# See fixperms.1 for the full description.  Exit status: 0 everything is (or
# would be) fixed, 1 something could not be fixed, 2 usage error.

set -u
export LC_ALL=C
shopt -s nullglob dotglob extglob

VERSION=1.1
PROG=${0##*/}
ORIG_ARGS=("$@")

usage() {
    cat <<EOF
Usage: $PROG [OPTION]... PATH...
Repair owner, group, mode and ACL of PATHs (recursively) so the invoking user
owns them and a non-elevated Cygwin shell can use them.

  -n, --dry-run          show what would change; change nothing
  -v, --verbose          list every change (twice: also unchanged entries)
  -d, --no-recurse       fix only the named PATHs, not what is under them
  -u, --user USER        owner to set (default: the invoking user)
  -g, --group GROUP      group to set (default: the invoking user's group)
  -w, --group-write      give the group write access (775/664, not 755/644;
                         under an "=" rule, where the group can read)
  -x, --exec-by-content  ignore existing x bits; set x only on files that
                         start with #!, MZ or ELF magic
  -f, --force            allow /, the Cygwin root, drive roots and top-level
                         directories such as /usr
  -r, --rules FILE       read extra rules from FILE (repeatable; checked
                         before the user rules file and the built-in ones)
  -R, --no-rules         ignore the built-in rules and the user rules file
  -l, --list-rules       print the rules in force, first match first, and exit
  -h, --help             show this help and exit
  -V, --version          show the version and exit

Exit status: 0 all fixed, 1 something could not be fixed, 2 usage error.
EOF
}

die_usage() {
    printf '%s: %s\n' "$PROG" "$1" >&2
    printf "Try '%s --help' for more information.\n" "$PROG" >&2
    exit 2
}

# ---------------------------------------------------------------- options

dry_run=0 verbose=0 recurse=1 force=0 group_write=0 exec_by_content=0
use_rules=1 list_rules=0
opt_user='' opt_group=''
paths=() rule_files=()

while (($#)); do
    arg=$1
    shift
    case $arg in
    --) paths+=("$@"); break ;;
    -n|--dry-run) dry_run=1 ;;
    -v|--verbose) ((verbose++)) ;;
    -d|--no-recurse) recurse=0 ;;
    -w|--group-write) group_write=1 ;;
    -x|--exec-by-content) exec_by_content=1 ;;
    -f|--force) force=1 ;;
    -R|--no-rules) use_rules=0 ;;
    -l|--list-rules) list_rules=1 ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "$PROG $VERSION"; exit 0 ;;
    -u|--user|-g|--group|-r|--rules)
        (($#)) || die_usage "option '$arg' requires an argument"
        case $arg in
        -u|--user) opt_user=$1 ;;
        -g|--group) opt_group=$1 ;;
        *) rule_files+=("$1") ;;
        esac
        shift ;;
    --user=*) opt_user=${arg#*=} ;;
    --group=*) opt_group=${arg#*=} ;;
    --rules=*) rule_files+=("${arg#*=}") ;;
    -[nvdwxfhVRl][nvdwxfhVRl]*)
        # Bundled flags such as -nv: split into single flags.
        flags=()
        for ((j = 1; j < ${#arg}; j++)); do flags+=("-${arg:j:1}"); done
        set -- "${flags[@]}" "$@" ;;
    -?*) die_usage "unknown option '$arg'" ;;
    *) paths+=("$arg") ;;
    esac
done
((${#paths[@]} || list_rules)) || die_usage "no PATH given"
((dry_run && !verbose)) && verbose=1

# ---------------------------------------------------------------- environment

for tool in stat chown chmod getfacl setfacl realpath; do
    command -v "$tool" >/dev/null || { echo "$PROG: '$tool' not found" >&2; exit 2; }
done

CYGWIN=0
[[ $(uname -s) == CYGWIN* ]] && CYGWIN=1

# Elevated?  On Cygwin an elevated token lists Administrators (gid 544) in
# id -G; a non-elevated one has it only as a deny-only SID, which id omits.
ELEVATED=0
MY_UID=$(id -u)
if ((CYGWIN)); then
    [[ " $(id -G) " == *" 544 "* ]] && ELEVATED=1
else
    [[ $(id -u) == 0 ]] && ELEVATED=1
fi

if [[ -n $opt_user ]]; then
    T_UID=$(id -u -- "$opt_user" 2>/dev/null) || die_usage "unknown user '$opt_user'"
    T_USER=$opt_user
else
    T_UID=$(id -u) T_USER=$(id -un)
fi
if [[ -n $opt_group ]]; then
    if [[ $opt_group =~ ^[0-9]+$ ]]; then
        T_GID=$opt_group
    else
        T_GID=$(getent group -- "$opt_group" 2>/dev/null | cut -d: -f3)
        [[ -n $T_GID ]] || die_usage "unknown group '$opt_group'"
    fi
    T_GROUP=$opt_group
elif [[ -n $opt_user ]]; then
    T_GID=$(id -g -- "$opt_user") T_GROUP=$(id -gn -- "$opt_user")
else
    T_GID=$(id -g) T_GROUP=$(id -gn)
fi
T_HOME=$(getent passwd -- "$T_USER" 2>/dev/null | cut -d: -f6)
T_HOME=${T_HOME%/}

# ---------------------------------------------------------------- rules
#
# Each rule is: PATTERN DIR-MODE FILE-MODE OWNER.  The first rule whose
# PATTERN matches an entry's absolute path decides its mode and owner; entries
# no rule matches get the defaults (755/644, the invoking user).
#
# PATTERN  An absolute path glob.  * and ? stay within one path component,
#          ** matches across them, and a leading ~ means any home directory
#          (/home/NAME, and the target user's home wherever it is).  Matched
#          case-insensitively on Cygwin.
# MODE     - the default (755/644, with x for executables),
#          = keep the current mode, minus write for group and others
#            (and never less for the group than for others); the owner
#            always gets rw (rwx on a directory), and a file with
#            executable content gets x where it has r.  Never loosens.
#          or octal: 700, 600, 1777 ...  Executable files get x added
#          wherever the mode has r (600 -> 700).  Setuid/setgid/sticky bits
#          in a rule are added to any the entry already has.
# OWNER    user   the invoking user (or --user/--group)
#          keep   leave owner and group alone (service files, shared dirs)
#          home   the account the /home/NAME directory belongs to; the
#                 invoking user inside their own home or when --user is given
#          base   the account named by the file's own name (/var/mail/NAME)
#          NAME   that account
#          home and base leave owner and group alone if there is no such
#          account.

BUILTIN_RULES='
# PATTERN                       DIR   FILE  OWNER
~/.ssh                          700   -     home
~/.ssh/**.pub                   700   644   home
~/.ssh/known_hosts*             700   644   home
~/.ssh/**                       700   600   home
~/.gnupg                        700   -     home
~/.gnupg/**                     700   600   home
~/.getmail                      700   -     home
~/.getmail/**                   700   600   home
~/.aws/credentials              -     600   home
~/.kube/config                  -     600   home
~/.docker/config.json           -     600   home
~/.netrc                        -     600   home
~/.authinfo*                    -     600   home
~/.git-credentials              -     600   home
~/.msmtprc                      -     600   home
~/.fetchmailrc                  -     600   home
~/.pgpass                       -     600   home
~/.my.cnf                       -     600   home
~/.Xauthority                   -     600   home
~                               =     -     home
~/**                            =     =     home
/var/mail                       1777  -     keep
/var/mail/*                     -     600   base
/var/spool/mail                 1777  -     keep
/var/spool/mail/*               -     600   base
/tmp                            1777  -     keep
/tmp/**                         =     =     keep
/var/tmp                        1777  -     keep
/var/tmp/**                     =     =     keep
/var/log                        1777  -     keep
/var/log/**                     =     =     keep
/var/empty                      755   -     keep
/etc/ssh_host_*_key             -     600   keep
/etc/ssh_host_*_key.pub         -     644   keep
/etc/ssh/ssh_host_*_key         -     600   keep
/etc/ssh/ssh_host_*_key.pub     -     644   keep
/etc/sshd_config                -     644   keep
/etc/ssh/sshd_config            -     644   keep
'
USER_RULES=${XDG_CONFIG_HOME:-${T_HOME:-$HOME}/.config}/fixperms/rules

R_PAT=() R_DM=() R_FM=() R_OWN=() R_SRC=()

# Accounts by name: uid, gid and group name, looked up once each.
declare -A A_UID=() A_GID=() A_GN=()
lookup_acct() {  # lookup_acct NAME: true, with AU AG AGN set, if NAME exists
    local n=$1 ent _n _x _u _g
    if [[ -z ${A_UID[$n]+x} ]]; then
        A_UID[$n]=
        if ent=$(getent passwd -- "$n" 2>/dev/null) && [[ -n $ent ]]; then
            IFS=: read -r _n _x _u _g _ <<<"$ent"
            A_UID[$n]=$_u A_GID[$n]=$_g
            A_GN[$n]=$(id -gn -- "$n" 2>/dev/null) || A_GN[$n]=$_g
        fi
    fi
    AU=${A_UID[$n]} AG=${A_GID[$n]:-} AGN=${A_GN[$n]:-}
    [[ -n $AU ]]
}

# Turn a rule glob into an extglob: ** -> *, * -> *([!/]), ? -> [!/].
glob_to_pat() {
    local g=$1
    g=${g//\*\*/$'\1'}
    g=${g//\*/'*([!/])'}
    g=${g//\?/'[!/]'}
    REPLY=${g//$'\1'/*}
}

add_rule() {  # add_rule SOURCE PATTERN DIR FILE OWNER
    local src=$1 pat=$2 dm=$3 fm=$4 own=$5
    # shellcheck disable=SC2088  # a literal ~, not a home to expand
    [[ $pat == /* || $pat == '~' || $pat == '~/'* ]] ||
        { echo "$PROG: $src: pattern must be absolute or start with ~: $pat" >&2; exit 2; }
    [[ $dm =~ ^(-|=|[0-7]{3,4})$ && $fm =~ ^(-|=|[0-7]{3,4})$ ]] ||
        { echo "$PROG: $src: bad mode in rule for $pat (use -, = or octal)" >&2; exit 2; }
    case $own in
    user|keep|home|base) ;;
    *) lookup_acct "$own" || { echo "$PROG: $src: unknown account '$own' in rule for $pat" >&2; exit 2; } ;;
    esac
    if [[ $pat == '~'* ]]; then
        glob_to_pat "${pat:1}"
        R_PAT+=("/home/+([!/])$REPLY") R_DM+=("$dm") R_FM+=("$fm") R_OWN+=("$own") R_SRC+=("$src: $pat")
        # The target user's home, if it is somewhere other than /home.
        if [[ -n $T_HOME && $T_HOME != /home/+([!/]) ]]; then
            R_PAT+=("$T_HOME$REPLY") R_DM+=("$dm") R_FM+=("$fm") R_OWN+=("$own") R_SRC+=("$src: $pat")
        fi
    else
        glob_to_pat "$pat"
        R_PAT+=("$REPLY") R_DM+=("$dm") R_FM+=("$fm") R_OWN+=("$own") R_SRC+=("$src: $pat")
    fi
}

load_rules() {  # load_rules SOURCE-NAME < rules text
    local line pat dm fm own extra n=0
    while IFS= read -r line; do
        ((n++))
        line=${line%%#*}
        pat='' dm='' fm='' own='' extra=''
        read -r pat dm fm own extra <<<"$line"
        [[ -z $pat ]] && continue
        [[ -n $own && -z $extra ]] ||
            { echo "$PROG: $1:$n: want PATTERN DIR-MODE FILE-MODE OWNER" >&2; exit 2; }
        add_rule "$1:$n" "$pat" "$dm" "$fm" "$own"
    done
}

for f in "${rule_files[@]}"; do
    [[ -r $f ]] || die_usage "cannot read rules file '$f'"
    # shellcheck disable=SC2094  # load_rules only reads
    load_rules "$f" <"$f"
done
if ((use_rules)); then
    # shellcheck disable=SC2094
    [[ -r $USER_RULES ]] && load_rules "$USER_RULES" <"$USER_RULES"
    load_rules builtin <<<"$BUILTIN_RULES"
fi

if ((list_rules)); then
    printf '%-44s %-5s %-5s %s\n' "# RULE (first match wins)" DIR FILE OWNER
    for ((j = 0; j < ${#R_PAT[@]}; j++)); do
        printf '%-44s %-5s %-5s %s\n' "${R_SRC[j]}" "${R_DM[j]}" "${R_FM[j]}" "${R_OWN[j]}"
    done
    ((${#R_PAT[@]})) || echo "# (no rules: every entry gets 755/644 and the invoking user)"
    exit 0
fi

# Index of the first rule matching absolute path $1 in RI, or -1.
match_rule() {
    local j
    RI=-1
    ((CYGWIN)) && shopt -s nocasematch
    for ((j = 0; j < ${#R_PAT[@]}; j++)); do
        # shellcheck disable=SC2053  # the pattern is meant to match as a glob
        if [[ $1 == ${R_PAT[j]} ]]; then RI=$j; break; fi
    done
    ((CYGWIN)) && shopt -u nocasematch
    return 0
}

# Owner for OWNER token $1 at absolute path $2: OU OG OUN OGN, or OU='' to
# leave the owner and group alone.
resolve_owner() {
    local tok=$1 abs=$2 name=''
    OU='' OG='' OUN='' OGN=''
    case $tok in
    keep) return 0 ;;
    user) ;;
    home)
        if [[ -z $opt_user && $abs != "$T_HOME" && $abs != "$T_HOME"/* &&
              $abs == /home/+([!/])?(/*) ]]; then
            name=${abs#/home/}
            name=${name%%/*}
        fi ;;
    base) name=${abs##*/} ;;
    *) name=$tok ;;
    esac
    if [[ -z $name ]]; then
        OU=$T_UID OG=$T_GID OUN=$T_USER OGN=$T_GROUP
    elif lookup_acct "$name"; then
        OU=$AU OG=$AG OUN=$name OGN=$AGN
    fi
    return 0
}

# ---------------------------------------------------------------- helpers

declare -A FAIL_MSG=()  # path -> why it could not be fixed
FAIL_ORDER=()
n_checked=0 n_ok=0 n_fixed=0 n_owner=0 n_acl=0 n_links=0 n_skipped=0
n_unscanned=0 n_icacls=0 n_elev=0

say() { printf '%s\n' "$*"; }
vsay() { ((verbose >= ${1})) && printf '%s\n' "${*:2}"; return 0; }

fail() {  # fail PATH MESSAGE [elev]
    [[ -n ${FAIL_MSG[$1]+x} ]] || FAIL_ORDER+=("$1")
    FAIL_MSG[$1]=$2
    [[ ${3:-} == elev ]] && ((n_elev++))
    return 0
}

# The helpers below return their result in REPLY: a $(...) per entry would
# cost a fork each, which is slow on Cygwin.
PERM=(--- --x -w- -wx r-- r-x rw- rwx)

# The canonical form of the ACL that setfacl -s gives for MODE (3 octal
# digits), as getfacl -c prints it with the lines joined by commas.
# A world-writable directory (/tmp, /var/mail) gets default entries without
# write for group and others, so that what is created in it is not.
acl_for() {  # acl_for dir|file MODE
    local u=${PERM[${2:0:1}]} g=${PERM[${2:1:1}]} o=${PERM[${2:2:1}]}
    REPLY="user::$u,group::$g,other::$o"
    if [[ $1 == dir ]]; then
        if ((${2:2:1} & 2)); then
            g=${PERM[${2:1:1} & 5]} o=${PERM[${2:2:1} & 5]}
        fi
        REPLY+=",default:user::$u,default:group::$g,default:other::$o"
    fi
    return 0
}

# The same ACL in setfacl's short syntax: u::rwx,g::r-x,o::r-x,d:u::rwx,...
setfacl_spec() {  # setfacl_spec dir|file MODE
    acl_for "$1" "$2"
    REPLY=${REPLY//default:/d:}
    REPLY=${REPLY//user:/u:}
    REPLY=${REPLY//group:/g:}
    REPLY=${REPLY//other:/o:}
}

# MODE (3 digits) with x added wherever there is r: 644 -> 755, 600 -> 700.
add_rx() {
    local m=$1 d out='' k
    for ((k = 0; k < 3; k++)); do
        d=${m:k:1}
        ((d & 4)) && d=$((d | 1))
        out+="$d"
    done
    REPLY=$out
}

# The "=" mode: the current one (from the ACL's base entries when there are
# any, as the group bits ls shows may really be the mask), minus write for
# group and others, the group at least as much as others, and never less than
# rw (rwx for a directory) for the owner.
keep_mode() {  # keep_mode dir|file MODE ACL
    local m=$2 acl=",$3," e s d u='' g='' o='' mask=7
    for e in user group other mask; do
        [[ $acl == *",$e::"???","* ]] || continue
        s=${acl#*",$e::"}
        s=${s:0:3} d=0
        [[ $s == r?? ]] && ((d += 4))
        [[ $s == ?w? ]] && ((d += 2))
        [[ $s == ??x ]] && ((d += 1))
        case $e in user) u=$d ;; group) g=$d ;; other) o=$d ;; mask) mask=$d ;; esac
    done
    u=${u:-${m:0:1}} g=${g:-${m:1:1}} o=${o:-${m:2:1}}
    g=$((g & mask))   # the group's effective rights
    if [[ $1 == dir ]]; then u=7; else u=$((u | 6)); fi
    g=$(((g | o) & 5)) o=$((o & 5))
    REPLY=$u$g$o
}

has_exec_magic() {  # true if the file starts with #!, MZ or \177ELF
    local hdr=
    IFS= read -r -n 4 hdr <"$1" 2>/dev/null || [[ -n $hdr ]] || return 1
    [[ $hdr == '#!'* || $hdr == MZ* || $hdr == $'\177'ELF ]]
}

# Is PATH dangerous to work on without --force?  Refuses /, the Cygwin root,
# drive roots and anything directly under them (/usr, /home, D:/Users, ...).
too_close_to_root() {
    local r m lm rel
    r=$(realpath -- "$1" 2>/dev/null) || r=$1
    if ((CYGWIN)); then
        m=$(cygpath -m -- "$r") lm=${m,,}
        lm=${lm%/} m=${m%/}
        if [[ $lm == "$ROOT_LM" ]]; then
            rel=
        elif [[ $lm == "$ROOT_LM"/* ]]; then
            rel=${m:${#ROOT_LM}+1}
        elif [[ $lm =~ ^[a-z]: ]]; then
            rel=${m:3}
        elif [[ $m == //* ]]; then   # //server/share/rest
            rel=${m#//}; rel=${rel#*/}; rel=${rel#*/}
            [[ $rel == "${m#//}" ]] && rel=
        else
            rel=${m#/}
        fi
    else
        rel=${r#/}
    fi
    rel=${rel%/}
    [[ -z $rel || $rel != */* ]]
}
if ((CYGWIN)); then ROOT_LM=$(cygpath -m /); ROOT_LM=${ROOT_LM,,}; ROOT_LM=${ROOT_LM%/}; fi

# Run CMD... -- BATCH[@]; if that fails, retry one path at a time so we know
# which ones failed.  Leaves the failed paths in BAD and their errors in BAD_ERR.
BAD=()
declare -A BAD_ERR=()
apply() {
    local err p
    BAD=()
    BAD_ERR=()
    ((${#BATCH[@]})) || return 0
    err=$("$@" -- "${BATCH[@]}" 2>&1 >/dev/null) && return 0
    for p in "${BATCH[@]}"; do
        if ! err=$("$@" -- "$p" 2>&1 >/dev/null); then
            BAD+=("$p")
            BAD_ERR[$p]=${err##*: }
        fi
    done
}

# Fill ST[] with one stat line per path (empty if stat failed for it).
STAT_FMT=$'%u\t%g\t%a\t%d\t%U\t%G\t%A\t%F'
stat_batch() {
    local out p
    ST=()
    if out=$(stat -c "$STAT_FMT" -- "$@" 2>/dev/null); then
        mapfile -t ST <<<"$out"
        ((${#ST[@]} == $#)) && return
    fi
    ST=()
    for p; do ST+=("$(stat -c "$STAT_FMT" -- "$p" 2>/dev/null)"); done
}

# Fill ACL[] with each path's getfacl -c output, lines joined by commas and
# the "#effective" comments dropped (empty if getfacl failed for it).
getfacl_one() {
    local l blk=
    while IFS= read -r l; do
        [[ -z $l ]] && break
        l=${l%%$'\t'*}
        blk+=${blk:+,}${l%%#*}
    done
    printf '%s' "$blk"
}
getfacl_batch() {
    local out l blk='' p
    ACL=()
    if out=$(getfacl -c -- "$@" 2>/dev/null); then
        while IFS= read -r l; do
            if [[ -z $l ]]; then
                [[ -n $blk ]] && ACL+=("$blk")
                blk=
            else
                l=${l%%$'\t'*}
                blk+=${blk:+,}${l%%#*}
            fi
        done <<<"$out"
        [[ -n $blk ]] && ACL+=("$blk")
        ((${#ACL[@]} == $#)) && return
    fi
    ACL=()
    for p; do ACL+=("$(getfacl -c -- "$p" 2>/dev/null | getfacl_one)"); done
}

# ---------------------------------------------------------------- the work

# Check and fix a batch of paths that all exist.  Directories among them that
# should be descended into are appended to SUBDIRS (relative to ROOT_DEV).
process_batch() {
    local -a items=("$@") kind=() tmode=() towner=() later=()
    local -a acl_paths=() acl_idx=()
    local i n=$# p u g a dev un gn ls ftype special cur_special cur_acl want own_change msg
    local abs tok otok rule exe base
    local -a why
    stat_batch "$@"
    local -a st=("${ST[@]}")

    # Pass 1: classify; collect the dirs and files for one getfacl call.
    for ((i = 0; i < n; i++)); do
        p=${items[i]}
        ((n_checked++))
        if [[ -z ${st[i]} ]]; then
            kind[i]=bad
            fail "$p" "cannot stat (no permission on its parent directory?)"
            continue
        fi
        IFS=$'\t' read -r u g a dev un gn ls ftype <<<"${st[i]}"
        case $ftype in
        directory) kind[i]=dir ;;
        regular*) kind[i]='file' ;;
        "symbolic link") kind[i]='link' ;;
        *) kind[i]=other ;;
        esac
        if [[ ${kind[i]} == dir || ${kind[i]} == file ]]; then
            acl_paths+=("$p")
            acl_idx+=("$i")
        fi
    done
    if ((${#acl_paths[@]})); then
        getfacl_batch "${acl_paths[@]}"
    else
        ACL=()
    fi
    local -a acls=()
    for ((i = 0; i < ${#acl_idx[@]}; i++)); do acls[acl_idx[i]]=${ACL[i]}; done

    # Pass 2: decide what each one needs and report it.
    local -a do_chown=() do_acl=()
    declare -A by_spec=()
    for ((i = 0; i < n; i++)); do
        [[ ${kind[i]} == bad ]] && continue
        p=${items[i]}
        IFS=$'\t' read -r u g a dev un gn ls ftype <<<"${st[i]}"
        abs=$ABS_ROOT${p:${#OPERAND}}
        match_rule "$abs"
        if ((RI >= 0)); then
            [[ ${kind[i]} == dir ]] && tok=${R_DM[RI]} || tok=${R_FM[RI]}
            otok=${R_OWN[RI]} rule=" (rule ${R_SRC[RI]#*: })"
        else
            tok=- otok=user rule=
        fi
        resolve_owner "$otok" "$abs"
        why=()
        own_change=0
        if [[ -n $OU ]]; then
            towner[i]=$OU:$OG
            if [[ $u != "$OU" ]]; then
                why+=("owner $un -> $OUN")
                own_change=1
            fi
            if [[ $g != "$OG" ]]; then
                why+=("group $gn -> $OGN")
                own_change=1
            fi
        fi

        case ${kind[i]} in
        link|other)
            # Never follow a symlink: chown -h changes the link itself, and
            # neither setfacl nor chmod is applied to links or special files.
            if [[ ${kind[i]} == link ]]; then ((n_links++)); else ((n_skipped++)); fi
            if ((own_change)); then
                vsay 1 "${DRY:+would }fix ${kind[i]} ${p}: ${why[*]}$rule"
                do_chown+=("$i")
            else
                vsay 2 "ok (${kind[i]}, owner only) $p"
                ((n_ok++))
            fi
            continue ;;
        esac

        # Target mode.  a holds 3 or 4 octal digits; special bits are kept,
        # plus any a rule adds.
        cur_acl=${acls[i]:-}
        cur_special=0
        ((${#a} == 4)) && cur_special=${a:0:1}
        special=$cur_special
        a=${a: -3}
        exe=0
        if [[ $tok == = ]]; then
            keep_mode "${kind[i]}" "$a" "$cur_acl"
            base=$REPLY
            # -w: group write wherever the group can already read.
            if ((group_write && ${base:1:1} & 4)); then
                base=${base:0:1}$((${base:1:1} | 2))${base:2:1}
            fi
            if [[ ${kind[i]} == file && $base != *[1357]* ]]; then
                if [[ -r $p ]]; then
                    if has_exec_magic "$p"; then
                        add_rx "$base"
                        base=$REPLY
                    fi
                else
                    later+=("$i")
                fi
            fi
        else
            if [[ $tok == - ]]; then
                [[ ${kind[i]} == dir ]] && base=755 || base=644
            else
                base=${tok: -3}
                ((${#tok} == 4)) && special=$((special | ${tok:0:1}))
            fi
            if [[ ${kind[i]} == file ]]; then
                # An explicit rule mode states what the file should be, so
                # only its content can make it executable, not old x bits.
                if ((!exec_by_content)) && [[ $tok == - && $a == *[1357]* ]]; then
                    exe=1
                elif [[ -r $p ]]; then
                    has_exec_magic "$p" && exe=1
                else
                    later+=("$i")   # unreadable: look at its first bytes once fixed
                fi
                if ((exe)); then
                    add_rx "$base"
                    base=$REPLY
                fi
            fi
            if [[ $tok == - ]] && ((group_write)); then
                base=${base:0:1}$((${base:1:1} | 2))${base:2:1}
            fi
        fi
        tmode[i]=$base
        ((special)) && tmode[i]=$special$base
        acl_for "${kind[i]}" "$base"
        want=$REPLY
        if [[ $cur_acl != "$want" ]] || ((own_change || special != cur_special)); then
            if [[ $cur_acl != "$want" ]] || ((special != cur_special)); then
                if [[ $cur_acl == *user:?*:* || $cur_acl == *group:?*:* || $cur_acl == *mask::* || -z $cur_acl ]]; then
                    why+=("mode $ls+ -> ${tmode[i]} (ACL cleaned)")
                else
                    why+=("mode $ls -> ${tmode[i]}")
                fi
            fi
            if ((verbose)); then
                printf -v msg '; %s' "${why[@]}"
                say "${DRY:+would }fix $p: ${msg:2}$rule"
            fi
            ((own_change)) && do_chown+=("$i")
            do_acl+=("$i")
            by_spec["${kind[i]} $base"]+="$i "
        else
            vsay 2 "ok $p"
            ((n_ok++))
        fi
        if [[ ${kind[i]} == dir ]] && ((recurse)); then
            if [[ $dev != "$ROOT_DEV" ]]; then
                vsay 1 "not descending into $p (another file system)"
            else
                SUBDIRS+=("$p")
            fi
        fi
    done

    # Predict failures in dry-run mode: taking a file from another account, or
    # giving one to another account, needs an elevated shell.
    if ((dry_run)); then
        for i in "${do_chown[@]}"; do
            IFS=$'\t' read -r u _ <<<"${st[i]}"
            if ((!ELEVATED)) && [[ $u != "$MY_UID" ]]; then
                fail "${items[i]}" "owned by another account: changing it needs an elevated shell" elev
            elif ((!ELEVATED)) && [[ ${towner[i]%%:*} != "$MY_UID" ]]; then
                fail "${items[i]}" "giving it to another account needs an elevated shell" elev
            fi
        done
        local k
        for k in "${!by_spec[@]}"; do
            for i in ${by_spec[$k]}; do
                [[ -n ${FAIL_MSG[${items[i]}]+x} ]] || ((n_fixed++))
            done
        done
        for i in "${do_chown[@]}"; do
            [[ ${kind[i]} == link || ${kind[i]} == other ]] && ((n_fixed++))
        done
        ((n_owner += ${#do_chown[@]}, n_acl += ${#do_acl[@]}))
        return
    fi

    # 1. chown everything that needs it, one call per new owner.
    declare -A chown_bad=() by_owner=()
    local k kk mm
    for i in "${do_chown[@]}"; do by_owner[${towner[i]}]+="$i "; done
    for k in "${!by_owner[@]}"; do
        BATCH=()
        for i in ${by_owner[$k]}; do BATCH+=("${items[i]}"); done
        apply chown -h "$k"
        for p in "${BAD[@]}"; do
            chown_bad[$p]=1
            if ((!ELEVATED)); then
                fail "$p" "chown: ${BAD_ERR[$p]} - needs an elevated shell" elev
            else
                fail "$p" "chown: ${BAD_ERR[$p]}"
            fi
        done
    done
    for i in "${do_chown[@]}"; do
        p=${items[i]}
        [[ -n ${chown_bad[$p]+x} ]] && continue
        ((n_owner++))
        [[ ${kind[i]} == link || ${kind[i]} == other ]] && ((n_fixed++))
    done

    # 2. setfacl -s, one call per (kind, mode); icacls + chmod as the fallback.
    for k in "${!by_spec[@]}"; do
        kk=${k% *} mm=${k#* }
        BATCH=()
        for i in ${by_spec[$k]}; do
            [[ -n ${chown_bad[${items[i]}]+x} ]] || BATCH+=("${items[i]}")
        done
        ((${#BATCH[@]})) || continue
        setfacl_spec "$kk" "$mm"
        apply setfacl -s "$REPLY"
        declare -A acl_bad=()
        for p in "${BAD[@]}"; do
            if ((CYGWIN)) && icacls "$(cygpath -w -- "$p")" /reset /Q >/dev/null 2>&1 &&
                chmod "$mm" -- "$p" 2>/dev/null; then
                vsay 1 "  setfacl failed (${BAD_ERR[$p]}); reset with icacls + chmod $mm: $p"
                ((n_icacls++))
            else
                acl_bad[$p]=1
                if ((!ELEVATED)); then
                    fail "$p" "setfacl: ${BAD_ERR[$p]} - try an elevated shell" elev
                else
                    fail "$p" "setfacl: ${BAD_ERR[$p]}"
                fi
            fi
        done
        for i in ${by_spec[$k]}; do
            p=${items[i]}
            [[ -n ${chown_bad[$p]+x} || -n ${acl_bad[$p]+x} ]] && continue
            ((n_acl++, n_fixed++))
            # setfacl -s keeps setuid/setgid/sticky on Cygwin, but make sure.
            if [[ ${#tmode[i]} == 4 ]]; then
                chmod "${tmode[i]}" -- "$p" 2>/dev/null ||
                    fail "$p" "chmod ${tmode[i]} failed (special bits)"
            fi
        done
        unset acl_bad
    done

    # 3. Files that were unreadable before: now we can see if they need x.
    for i in "${later[@]}"; do
        p=${items[i]}
        [[ -n ${FAIL_MSG[$p]+x} ]] && continue
        if has_exec_magic "$p"; then
            local xm
            add_rx "${tmode[i]: -3}"
            xm=$REPLY
            setfacl_spec file "$xm"
            if setfacl -s "$REPLY" -- "$p" 2>/dev/null; then
                vsay 1 "  executable content, mode -> $xm: $p"
            else
                fail "$p" "could not add execute permission"
            fi
        fi
    done
}

# Walk DIR top-down: the directory itself was fixed by its parent's batch (or
# as an operand), so by the time we list it we can read it.
walk() {
    local d=$1 i
    if [[ ! -r $d || ! -x $d ]]; then
        if ((dry_run)); then
            vsay 1 "  (contents of $d not checked: unreadable until it is fixed)"
            ((n_unscanned++))
        else
            fail "$d" "cannot read the directory to fix its contents"
        fi
        return
    fi
    local -a kids=("$d"/*)
    local -a subs=()
    for ((i = 0; i < ${#kids[@]}; i += 200)); do
        SUBDIRS=()
        process_batch "${kids[@]:i:200}"
        subs+=("${SUBDIRS[@]}")
    done
    for i in "${subs[@]}"; do walk "$i"; done
}

DRY=
((dry_run)) && DRY=1
status=0

if ((dry_run)); then
    say "$PROG: dry run - nothing will be changed"
fi
if ((CYGWIN && !ELEVATED)); then
    vsay 1 "$PROG: not elevated; files owned by other accounts (e.g. Administrators) may need an elevated shell"
fi

for p in "${paths[@]}"; do
    p=${p%/}
    [[ -z $p ]] && p=/
    if [[ ! -e $p && ! -L $p ]]; then
        fail "$p" "no such file or directory"
        continue
    fi
    if ((!force)) && too_close_to_root "$p"; then
        printf "%s: refusing to work on '%s' (/, the Cygwin root, a drive root or a top-level directory); use --force\n" \
            "$PROG" "$p" >&2
        status=1
        continue
    fi
    ROOT_DEV=$(stat -c %d -- "$p" 2>/dev/null)
    # The operand's absolute path (symlinks in it not resolved), in Cygwin's
    # own spelling (/var/mail, not D:/cygwin/var/mail), for matching rules.
    OPERAND=$p
    ABS_ROOT=$(realpath -s -- "$p")
    ((CYGWIN)) && ABS_ROOT=$(cygpath -u -- "$(cygpath -m -- "$ABS_ROOT")")
    ABS_ROOT=${ABS_ROOT%/}
    [[ $p == / ]] && OPERAND=
    SUBDIRS=()
    process_batch "$p"
    if ((recurse)) && ((${#SUBDIRS[@]})); then
        walk "$p"
    fi
done

# ---------------------------------------------------------------- summary

((${#FAIL_ORDER[@]})) && status=1
summary="$n_checked checked, $n_ok already fine, $n_fixed ${DRY:+would be }fixed"
summary+=" ($n_owner owner/group, $n_acl mode/ACL"
((n_icacls)) && summary+=", $n_icacls via icacls"
summary+=")"
((n_links)) && summary+=", $n_links symlinks not followed"
((n_skipped)) && summary+=", $n_skipped special files"
((n_unscanned)) && summary+=", $n_unscanned directories not looked into"
((${#FAIL_ORDER[@]})) && summary+=", ${#FAIL_ORDER[@]} ${DRY:+would }fail"
say "$PROG: $summary"

if ((${#FAIL_ORDER[@]})); then
    for p in "${FAIL_ORDER[@]}"; do
        printf '%s: %s: %s\n' "$PROG" "$p" "${FAIL_MSG[$p]}" >&2
    done
    if ((n_elev)); then
        printf '%s: %d of these need an elevated shell.  Open Cygwin with "Run as administrator" and run:\n' \
            "$PROG" "$n_elev" >&2
        printf '  %s' "$PROG" >&2
        printf ' %q' "${ORIG_ARGS[@]}" >&2
        printf '\n' >&2
    fi
fi
exit "$status"
