#!/usr/bin/env python3
"""
wincygterm - run Cygwin programs on a real pty inside Windows Terminal.

Usage (with a NATIVE Windows Python, not Cygwin's):
    python wincygterm [--root DIR] [--python EXE] [--term TERM] [--login-dir]
                      [--debug FILE] [--no-reset] [--no-direct] [--] [CMD [ARG...]]
    python wincygterm --profile        print a Windows Terminal profile command line
    python wincygterm --version

CMD defaults to `/bin/bash -l`.

Inside the session (Cygwin's python3, on the pty):
    wincygterm --direct PROG [ARG...]      or, via a symlink named wcdirect:   wcdirect PROG [ARG...]
runs a NATIVE WINDOWS console program on the real console for as long as it lives, then goes back to the pty.
Use it for programs that read mouse events or write the screen with the Win32 console API (Microsoft Edit, say):
on the pty they sit behind Cygwin's pseudo console, which does not carry mouse events.  See "Direct" below.

Why: a Cygwin program started directly in a Windows Terminal tab talks to Cygwin's own console layer
(/dev/cons*), which swallows OSC colour queries on their way out (so a program cannot ask the terminal for its
colours) and, behind ssh, passes key input along in fragments that make ncurses programs print stray text.
A Cygwin program on a pty (what mintty and ssh give it, /dev/pty*) has neither problem.
Not needed in mintty or any other terminal that already runs Cygwin programs on a pty.

How: two halves in this one file.  The front-end runs on native Windows Python, puts its console into raw VT mode
and forwards bytes between the console and a pipe; it also tells the other half when the window is resized.
Nothing Cygwin sits on the console, so Windows Terminal's answers get through.  The helper (`--helper`, started by
the front-end, running on Cygwin's Python and detached from the console) runs CMD on a Cygwin pty and relays bytes
between that pty and the pipe.  Compare winpty, which goes the other way: it lets a Windows console program run
inside a Unix pty.

Direct: the pty is a text pipe, so a Windows console program that wants the console itself (mouse events from
ENABLE_MOUSE_INPUT, WriteConsoleOutput, ReadConsoleInput) is starved on it.  `wincygterm --direct PROG` hands the
console over for that one program.  The shim (Cygwin side) prints a private OSC string on the pty,
    ESC ] 7077 ; direct ; TOKEN ; BASE64(JSON{argv, cwd}) BEL
which the front-end cuts out of the output stream.  The front-end puts the console back to its original modes, runs
PROG attached to it, then returns to raw mode and answers on the pty with  ESC ] 7077 ; exit ; STATUS BEL.  (An
ESC ] 7077 ; ack BEL comes first, at once, so the shim can tell a front-end that does not know "direct" from a slow
program.)  TOKEN is a random per-session secret that only processes started by this wincygterm have (in
$WINCYGTERM_TOKEN): without it, text from a file you cat, or from a remote host you ssh to, could make the front-end run
programs on your PC.  A request with the wrong token is dropped without a trace.  --no-direct turns the feature off.

Windows only for the front-end; Python 3.8+ and the standard library only; Cygwin needs python3 installed.
"""
import argparse
import base64
import hmac
import json
import os
import re
import secrets
import shutil
import struct
import subprocess
import sys
import time

VERSION = "1.1"
HELPER_FLAG = "--helper"
DIRECT_FLAG = "--direct"
OSC_PREFIX = b"\x1b]7077;direct;"                          # front-end side: the request, cut out of the output stream
ACK = b"\x1b]7077;ack\x07"
ACK_TIMEOUT = 3.0                                          # seconds the shim waits for the front-end to say it heard
RESET = ("\x1b[?1000l\x1b[?1002l\x1b[?1003l\x1b[?1006l"     # mouse reporting off
         "\x1b[?2004l"                                        # bracketed paste off
         "\x1b[<u\x1b[>4m"                                    # kitty keyboard / modifyOtherKeys back
         "\x1b[0m\x1b[?25h")                                  # attributes, cursor visible


# ---------------------------------------------------------------------------------------------------------------
# The helper: Cygwin side.
# ---------------------------------------------------------------------------------------------------------------

def helper_main(argv):
    """argv: ROWS COLS CMD [ARG...].  stdin: frames  type(1) length(2, big endian) payload  with 'D' = data for the
    pty, 'R' = resize (rows, cols as two big-endian 16-bit numbers).  stdout: what CMD writes to the pty.
    Exits with CMD's status (128+signal if it was killed)."""
    import fcntl
    import pty
    import select
    import signal
    import termios

    def set_size(fd, rows, cols):
        fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))

    def write_all(fd, data):
        while data:
            data = data[os.write(fd, data):]

    rows, cols, cmd = int(argv[0]), int(argv[1]), argv[2:]
    pid, master = pty.fork()
    if pid == 0:
        try:
            os.execvp(cmd[0], cmd)
        except OSError as e:
            sys.stderr.write("wincygterm: cannot run %s: %s\n" % (cmd[0], e))
            os._exit(127)
    set_size(master, rows, cols)
    buf, stdin_open = b"", True
    while True:
        try:
            ready = select.select([master] + ([0] if stdin_open else []), [], [])[0]
        except InterruptedError:
            continue
        if master in ready:
            try:
                data = os.read(master, 65536)
            except OSError:
                data = b""
            if not data:
                break                                    # CMD closed the pty: it is over
            write_all(1, data)
        if 0 in ready:
            data = os.read(0, 65536)
            if not data:                                 # the front-end went away: hang up on CMD
                stdin_open = False
                try:
                    os.kill(pid, signal.SIGHUP)
                except OSError:
                    pass
                continue
            buf += data
            while len(buf) >= 3:
                kind, length = buf[0:1], struct.unpack(">H", buf[1:3])[0]
                if len(buf) < 3 + length:
                    break
                payload, buf = buf[3:3 + length], buf[3 + length:]
                if kind == b"D":
                    write_all(master, payload)
                elif kind == b"R" and length == 4:
                    set_size(master, *struct.unpack(">HH", payload))     # the tty driver sends SIGWINCH itself
    try:
        _, status = os.waitpid(pid, 0)
    except OSError:
        return 1
    return 128 + os.WTERMSIG(status) if os.WIFSIGNALED(status) else os.WEXITSTATUS(status)


def direct_main(argv):
    """The shim, run inside the session on the pty: ask the front-end to run argv[0] on the real console.  Returns the
    program's exit status (2 if this is not a wincygterm session, 3 if the front-end did not answer)."""
    import select
    import termios
    import tty
    token = os.environ.get("WINCYGTERM_TOKEN")
    if not argv or argv[0] in ("-h", "--help"):
        sys.stderr.write("usage: wincygterm --direct PROG [ARG...]   (or: wcdirect PROG [ARG...])\n"
                         "Runs a native Windows console program on the real console, then comes back.\n")
        return 2
    if not token or not os.environ.get("WINCYGTERM"):
        sys.stderr.write("wcdirect: not in a wincygterm session (WINCYGTERM_TOKEN is not set): just run the program\n")
        return 2

    def winpath(p):
        try:
            return subprocess.check_output(["cygpath", "-w", p]).decode("utf-8", "replace").strip() or p
        except (OSError, subprocess.CalledProcessError):
            return p                                           # not Cygwin (a test), or no cygpath: pass as it is

    exe = shutil.which(argv[0]) or argv[0]
    if os.sep in exe or "/" in exe:
        exe = winpath(exe)
    body = base64.b64encode(json.dumps({"argv": [exe] + argv[1:], "cwd": winpath(os.getcwd())}).encode("utf-8"))
    fd = os.open("/dev/tty", os.O_RDWR | os.O_NOCTTY)
    old = termios.tcgetattr(fd)
    tty.setraw(fd)                                             # the replies must not be echoed or line-buffered
    try:
        os.write(fd, OSC_PREFIX + token.encode("ascii") + b";" + body + b"\x07")
        pat = re.compile(rb"\x1b\]7077;(ack|exit;(\d+))\x07")
        buf, acked, deadline = b"", False, time.time() + ACK_TIMEOUT
        while True:
            m = pat.search(buf)
            if m:
                buf = buf[m.end():]
                if m.group(1) != b"ack":
                    return int(m.group(2))
                acked = True
                continue
            wait = None if acked else deadline - time.time()
            if wait is not None and wait <= 0:
                break
            if not select.select([fd], [], [], wait)[0]:
                continue
            data = os.read(fd, 4096)
            if not data:
                return 1
            buf += data
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        os.close(fd)
    sys.stderr.write("wcdirect: no answer from wincygterm in %d s (an older wincygterm, or started with --no-direct)\n"
                     % ACK_TIMEOUT)
    return 3


class RequestFilter(object):
    """Cuts direct-run requests (ESC ] 7077 ; direct ; ... BEL|ST) out of the bytes the pty produced.  feed() ->
    (bytes to show, [request bodies]).  A request split across reads is held until it is whole; so is a tail that
    might be the start of one."""
    MAX = 1 << 16

    def __init__(self):
        self.held = b""

    def feed(self, data):
        data, out, found = self.held + data, b"", []
        self.held = b""
        while True:
            i = data.find(OSC_PREFIX)
            if i < 0:
                keep = 0                                       # the longest tail that is a proper prefix of OSC_PREFIX
                for n in range(min(len(OSC_PREFIX) - 1, len(data)), 0, -1):
                    if OSC_PREFIX.startswith(data[-n:]):
                        keep = n
                        break
                out += data[:len(data) - keep]
                self.held = data[len(data) - keep:]
                return out, found
            out += data[:i]
            ends = [(e, w) for e, w in ((data.find(b"\x07", i), 1), (data.find(b"\x1b\\", i), 2)) if e >= 0]
            if not ends:
                if len(data) - i > self.MAX:                   # never terminated: not ours, let it through
                    out += data[i:i + len(OSC_PREFIX)]
                    data = data[i + len(OSC_PREFIX):]
                    continue
                self.held = data[i:]
                return out, found
            end, width = min(ends)
            found.append(data[i + len(OSC_PREFIX):end])
            data = data[end + width:]


def parse_request(body, token):
    """-> (argv, cwd), or None if the token is wrong or the request is malformed."""
    given, _, payload = body.partition(b";")
    if not token or not hmac.compare_digest(given, token.encode("ascii")):
        return None
    try:
        req = json.loads(base64.b64decode(payload).decode("utf-8"))
        argv, cwd = req["argv"], req.get("cwd")
    except (ValueError, KeyError, TypeError):
        return None
    if not (isinstance(argv, list) and argv and all(isinstance(a, str) for a in argv)):
        return None
    return argv, (cwd if isinstance(cwd, str) and os.path.isdir(cwd) else None)


def direct_command(argv):
    """The command line to start: a bare name or one missing .exe is looked up the Windows way; .cmd / .bat go
    through cmd.exe, which CreateProcess cannot start by itself."""
    exe = argv[0]
    if not os.path.isfile(exe):
        exe = (exe + ".exe") if os.path.isfile(exe + ".exe") else (shutil.which(exe) or exe)
    if exe.lower().endswith((".cmd", ".bat")):
        return [os.environ.get("COMSPEC", "cmd.exe"), "/c", exe] + argv[1:]
    return [exe] + argv[1:]


# ---------------------------------------------------------------------------------------------------------------
# The front-end: Windows side.
# ---------------------------------------------------------------------------------------------------------------

def cygwin_path(path):
    """C:\\a\\b -> /cygdrive/c/a/b (the default Cygwin mount prefix)."""
    path = os.path.abspath(path)
    if len(path) > 1 and path[1] == ":":
        path = "/cygdrive/" + path[0].lower() + path[2:]
    return path.replace("\\", "/")


def registry_roots():
    """Cygwin installation directories recorded in the registry."""
    try:
        import winreg
    except ImportError:
        return []
    found = []
    for hive in (winreg.HKEY_LOCAL_MACHINE, winreg.HKEY_CURRENT_USER):
        for sub in (r"SOFTWARE\Cygwin\setup", r"SOFTWARE\WOW6432Node\Cygwin\setup"):
            try:
                with winreg.OpenKey(hive, sub) as key:
                    found.append(winreg.QueryValueEx(key, "rootdir")[0])
            except OSError:
                pass
    return found


COMMON_ROOTS = (r"C:\cygwin64", r"C:\cygwin", r"D:\cygwin64", r"D:\cygwin")


def find_root(given=None, environ=None):
    """The Cygwin root directory (the one with bin\\cygwin1.dll), or None."""
    environ = os.environ if environ is None else environ
    for c in ([given] if given else []) + [environ.get("CYGWIN_ROOT", "")] + registry_roots() + list(COMMON_ROOTS):
        if c and os.path.isfile(os.path.join(c, "bin", "cygwin1.dll")):
            return c
    return None


def find_cygwin_python(root):
    """The newest bin\\python3.N.exe under `root`, or None."""
    bindir = os.path.join(root, "bin")
    try:
        names = os.listdir(bindir)
    except OSError:
        return None
    found = sorted((n for n in names if n.startswith("python3.") and n.endswith(".exe") and n[8:-4].isdigit()),
                   key=lambda n: int(n[8:-4]), reverse=True)
    return os.path.join(bindir, found[0]) if found else None


def child_environment(root, term=None, login_dir=False, environ=None, token=None):    # allowlist secret
    """The environment CMD runs in: Cygwin's bin first on PATH, TERM (and COLORTERM under Windows Terminal) set,
    WINCYGTERM=<version> to say who is running it, and WINCYGTERM_TOKEN (if given) for `wcdirect`."""
    env = dict(os.environ if environ is None else environ)
    env["PATH"] = os.path.join(root, "bin") + os.pathsep + env.get("PATH", "")
    env["TERM"] = term or env.get("TERM") or "xterm-256color"
    env["WINCYGTERM"] = VERSION                          # lets termprobe (and you) tell this pty from a native one
    env.pop("WINCYGTERM_TOKEN", None)                    # never inherit another session's secret
    if token:
        env["WINCYGTERM_TOKEN"] = token
    if env.get("WT_SESSION") and not env.get("COLORTERM"):
        env["COLORTERM"] = "truecolor"
    if not login_dir:
        env["CHERE_INVOKING"] = "1"                      # /etc/profile: stay in the current directory
    return env


def profile_line(root=None):
    """The command line for a Windows Terminal profile that runs this tool."""
    line = '"%s" "%s"' % (sys.executable, os.path.abspath(__file__))
    return line + ((' --root "%s"' % root) if root else "") + " --login-dir"


class Win32(object):
    """The little of kernel32 the front-end needs."""
    ENABLE_PROCESSED_OUTPUT, ENABLE_VT_PROCESSING, DISABLE_NEWLINE_AUTO_RETURN = 0x1, 0x4, 0x8
    ENABLE_WINDOW_INPUT, ENABLE_VT_INPUT = 0x8, 0x200
    KEY_EVENT, WINDOW_BUFFER_SIZE_EVENT = 0x1, 0x4
    DETACHED_PROCESS = 0x8
    WAIT_OBJECT_0, WAIT_FAILED = 0, 0xFFFFFFFF

    def __init__(self):
        import ctypes
        from ctypes import wintypes
        self.c, self.w = ctypes, wintypes

        class KeyEvent(ctypes.Structure):
            _fields_ = [("down", wintypes.BOOL), ("repeat", wintypes.WORD), ("vk", wintypes.WORD),
                        ("scan", wintypes.WORD), ("char", wintypes.WCHAR), ("state", wintypes.DWORD)]

        class SizeEvent(ctypes.Structure):
            _fields_ = [("x", wintypes.SHORT), ("y", wintypes.SHORT)]

        class Record(ctypes.Structure):
            class U(ctypes.Union):
                _fields_ = [("key", KeyEvent), ("size", SizeEvent), ("pad", ctypes.c_byte * 16)]
            _anonymous_ = ("u",)
            _fields_ = [("type", wintypes.WORD), ("u", U)]

        class Info(ctypes.Structure):
            _fields_ = [("sx", wintypes.SHORT), ("sy", wintypes.SHORT), ("cx", wintypes.SHORT),
                        ("cy", wintypes.SHORT), ("attr", wintypes.WORD), ("left", wintypes.SHORT),
                        ("top", wintypes.SHORT), ("right", wintypes.SHORT), ("bottom", wintypes.SHORT),
                        ("mx", wintypes.SHORT), ("my", wintypes.SHORT)]

        self.Record, self.Info = Record, Info
        self.Handler = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.DWORD)
        k = self.k = ctypes.WinDLL("kernel32", use_last_error=True)
        k.CreateFileW.restype = wintypes.HANDLE
        k.CreateFileW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.c_void_p, wintypes.DWORD,
                                  wintypes.DWORD, wintypes.HANDLE]
        k.GetConsoleMode.argtypes = [wintypes.HANDLE, ctypes.POINTER(wintypes.DWORD)]
        k.SetConsoleMode.argtypes = [wintypes.HANDLE, wintypes.DWORD]
        k.WaitForMultipleObjects.argtypes = [wintypes.DWORD, ctypes.POINTER(wintypes.HANDLE), wintypes.BOOL,
                                             wintypes.DWORD]
        k.WaitForMultipleObjects.restype = wintypes.DWORD
        k.CreateEventW.argtypes = [ctypes.c_void_p, wintypes.BOOL, wintypes.BOOL, wintypes.LPCWSTR]
        k.CreateEventW.restype = wintypes.HANDLE
        k.SetEvent.argtypes = [wintypes.HANDLE]
        k.ResetEvent.argtypes = [wintypes.HANDLE]
        k.CloseHandle.argtypes = [wintypes.HANDLE]
        k.ReadConsoleInputW.argtypes = [wintypes.HANDLE, ctypes.POINTER(Record), wintypes.DWORD,
                                        ctypes.POINTER(wintypes.DWORD)]
        k.WriteConsoleW.argtypes = [wintypes.HANDLE, wintypes.LPCWSTR, wintypes.DWORD,
                                    ctypes.POINTER(wintypes.DWORD), ctypes.c_void_p]
        k.GetConsoleScreenBufferInfo.argtypes = [wintypes.HANDLE, ctypes.POINTER(Info)]
        k.FlushConsoleInputBuffer.argtypes = [wintypes.HANDLE]
        k.SetConsoleCtrlHandler.argtypes = [self.Handler, wintypes.BOOL]

    def open_console(self):
        """-> (hin, hout, old_in_mode, old_out_mode), or None if there is no console."""
        bad = self.w.HANDLE(-1).value
        hin = self.k.CreateFileW("CONIN$", 0xC0000000, 3, None, 3, 0, None)
        hout = self.k.CreateFileW("CONOUT$", 0xC0000000, 3, None, 3, 0, None)
        old_in, old_out = self.w.DWORD(), self.w.DWORD()
        if hin in (None, bad) or hout in (None, bad) or not (
                self.k.GetConsoleMode(hin, self.c.byref(old_in)) and self.k.GetConsoleMode(hout, self.c.byref(old_out))):
            return None
        return hin, hout, old_in.value, old_out.value

    def window_size(self, hout):
        info = self.Info()
        if not self.k.GetConsoleScreenBufferInfo(hout, self.c.byref(info)):
            return 24, 80
        return info.bottom - info.top + 1, info.right - info.left + 1

    def write(self, hout, text):
        n = self.w.DWORD()
        for i in range(0, len(text), 8192):
            chunk = text[i:i + 8192]
            self.k.WriteConsoleW(hout, chunk, len(chunk), self.c.byref(n), None)


def frontend_main(args):
    import codecs
    import threading
    import time

    root = find_root(args.root)
    if not root:
        sys.stderr.write("wincygterm: cannot find Cygwin (use --root C:\\cygwin or set CYGWIN_ROOT)\n")
        return 2
    cygpy = args.python or find_cygwin_python(root)
    if not cygpy or not os.path.isfile(cygpy):
        sys.stderr.write("wincygterm: no Cygwin python3 in %s\\bin (install Cygwin's python3, or use --python)\n" % root)
        return 2
    win = Win32()
    console = win.open_console()
    if console is None:
        sys.stderr.write("wincygterm: no console (run it in Windows Terminal or a console window)\n")
        return 2
    hin, hout, old_in, old_out = console
    cmd = args.cmd or ["/bin/bash", "-l"]
    rows, cols = win.window_size(hout)
    log = open(args.debug, "w") if args.debug else subprocess.DEVNULL
    token = secrets.token_hex(16)
    try:
        proc = subprocess.Popen(
            [cygpy, cygwin_path(os.path.abspath(__file__)), HELPER_FLAG, str(rows), str(cols)] + cmd,
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log,
            env=child_environment(root, args.term, args.login_dir, token=None if args.no_direct else token),
            creationflags=win.DETACHED_PROCESS)
    except OSError as e:
        sys.stderr.write("wincygterm: cannot start %s: %s\n" % (cygpy, e))
        return 2

    done = threading.Event()
    wlock = threading.Lock()
    wake = win.k.CreateEventW(None, True, False, None)      # manual-reset: tells the input loop to look at `done`

    def finish():
        done.set()
        win.k.SetEvent(wake)

    def send(kind, payload):
        with wlock:
            try:
                proc.stdin.write(struct.pack(">cH", kind, len(payload)) + payload)
                proc.stdin.flush()
            except (OSError, ValueError):
                finish()

    pending = []                                         # a direct-run request for the input loop (which owns the console)
    resume = threading.Event()                           # set by the input loop when that program has ended

    def request_direct(body):
        """Pump thread: a request to run a program on the real console.  Wrong token / malformed: dropped silently."""
        req = None if args.no_direct else parse_request(body, token)
        if req is None:
            return
        send(b"D", ACK)
        resume.clear()
        pending.append(req)
        win.k.SetEvent(wake)                             # wake the input loop ...
        while not resume.wait(0.5) and not done.is_set():
            pass                                         # ... and print nothing until the program is over

    def pump_output():
        decoder = codecs.getincrementaldecoder("utf-8")("replace")
        requests = RequestFilter()
        while True:
            data = proc.stdout.read1(65536)
            if not data:
                break
            data, found = requests.feed(data)
            if data:
                win.write(hout, decoder.decode(data))
            for body in found:
                request_direct(body)
        tail = decoder.decode(requests.held, final=False) + decoder.decode(b"", final=True)   # cut-off bytes at EOF
        if tail:
            win.write(hout, tail)
        finish()

    def on_ctrl(kind):                                   # console closed, user logging off, system shutting down
        if kind in (2, 5, 6):
            finish()
            time.sleep(1)                                # the process ends when this returns: let the cleanup run
            return True
        return False

    handler = win.Handler(on_ctrl)
    win.k.SetConsoleCtrlHandler(handler, True)
    def raw():
        win.k.SetConsoleMode(hin, win.ENABLE_VT_INPUT | win.ENABLE_WINDOW_INPUT)    # raw: no line input, echo, Ctrl-C
        win.k.SetConsoleMode(hout, old_out | win.ENABLE_PROCESSED_OUTPUT | win.ENABLE_VT_PROCESSING
                             | win.DISABLE_NEWLINE_AUTO_RETURN)
        win.k.FlushConsoleInputBuffer(hin)

    def run_direct(argv, cwd):
        """Input loop: give the console back as we found it, run the program on it, take it back, tell the shim."""
        win.k.SetConsoleMode(hin, old_in)
        win.k.SetConsoleMode(hout, old_out)
        win.k.FlushConsoleInputBuffer(hin)
        code = 127
        try:
            p = subprocess.Popen(direct_command(argv), cwd=cwd)          # no redirection: it inherits the console
            while True:
                try:
                    code = p.wait()
                    break
                except KeyboardInterrupt:                # Ctrl-C reaches us too; the program is the one that decides
                    continue
        except (OSError, ValueError) as e:
            win.write(hout, "wincygterm: cannot run %s: %s\r\n" % (argv[0], e))
        finally:
            raw()
            if not args.no_reset:
                win.write(hout, RESET)                   # the program may have left mouse reporting etc. on
            send(b"D", b"\x1b]7077;exit;%d\x07" % (code & 0xFFFFFFFF))
            win.k.ResetEvent(wake)
            resume.set()

    raw()
    pump = threading.Thread(target=pump_output, daemon=True)
    pump.start()
    try:
        recs, got = (win.Record * 128)(), win.w.DWORD()
        handles = (win.w.HANDLE * 2)(hin, wake)
        high, last_size = "", (rows, cols)
        while not done.is_set():
            resized = False
            which = win.k.WaitForMultipleObjects(2, handles, False, 500)
            if which == win.WAIT_FAILED:
                break
            if pending and not done.is_set():
                run_direct(*pending.pop(0))
                continue
            if which == win.WAIT_OBJECT_0:
                if not win.k.ReadConsoleInputW(hin, recs, 128, win.c.byref(got)):
                    break
                text = ""
                for i in range(got.value):
                    r = recs[i]
                    if r.type == win.KEY_EVENT and r.key.down and r.key.char != "\0":
                        ch = r.key.char
                        if "\ud800" <= ch < "\udc00":
                            high = ch                    # first half of a surrogate pair
                            continue
                        if "\udc00" <= ch < "\ue000" and high:
                            ch = chr(0x10000 + ((ord(high) - 0xD800) << 10) + (ord(ch) - 0xDC00))
                        high = ""
                        text += ch * max(r.key.repeat, 1)
                    elif r.type == win.WINDOW_BUFFER_SIZE_EVENT:
                        resized = True
                data = text.encode("utf-8", "replace")
                for i in range(0, len(data), 60000):
                    send(b"D", data[i:i + 60000])
            if resized or last_size != win.window_size(hout):       # events can be missed: look on idle ticks too
                size = win.window_size(hout)
                if size != last_size:
                    last_size = size
                    send(b"R", struct.pack(">HH", *size))
    finally:
        try:
            proc.stdin.close()
        except OSError:
            pass
        pump.join(2)
        if not args.no_reset:
            win.write(hout, RESET)
        win.k.SetConsoleMode(hin, old_in)
        win.k.SetConsoleMode(hout, old_out)
        win.k.SetConsoleCtrlHandler(handler, False)
        win.k.CloseHandle(wake)
    code = proc.wait()
    if args.debug:
        log.close()
    return code


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] == HELPER_FLAG:
        return helper_main(argv[1:])
    if argv and argv[0] == DIRECT_FLAG:
        return direct_main(argv[1:])
    if os.path.basename(sys.argv[0]).startswith("wcdirect"):          # invoked through a symlink named wcdirect
        return direct_main(argv)
    ap = argparse.ArgumentParser(prog="wincygterm",
                                 description="Run a Cygwin command on a real pty inside this Windows console.")
    ap.add_argument("--root", help="Cygwin root directory (default: $CYGWIN_ROOT, the registry, the usual places)")
    ap.add_argument("--python", help="the Cygwin python3 executable to use for the pty helper (default: the newest "
                                     "python3.N.exe in <root>\\bin)")
    ap.add_argument("--term", help="TERM for the command (default: $TERM, else xterm-256color)")
    ap.add_argument("--login-dir", action="store_true", help="start in the home directory, not the current one")
    ap.add_argument("--no-reset", action="store_true",
                    help="do not turn mouse reporting, bracketed paste &c off when the command ends")
    ap.add_argument("--no-direct", action="store_true",
                    help="ignore `wcdirect` requests (running a Windows console program on the real console)")
    ap.add_argument("--debug", metavar="FILE", help="write the helper's stderr to FILE")
    ap.add_argument("--profile", action="store_true", help="print a Windows Terminal profile command line and exit")
    ap.add_argument("--version", action="version", version="wincygterm " + VERSION)
    ap.add_argument("cmd", nargs="*", help="command to run (default: /bin/bash -l)")
    args = ap.parse_args(argv)
    if args.profile:
        print(profile_line(find_root(args.root) if args.root is None else args.root))
        return 0
    if os.name != "nt":
        sys.stderr.write("wincygterm: run this with a native Windows Python (it is the Windows half of a pair); on "
                         "Cygwin or Linux there is nothing to do - you already have a pty.\n")
        return 2
    return frontend_main(args)


if __name__ == "__main__":
    sys.exit(main())
