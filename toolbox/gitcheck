#!/usr/bin/env bash
# gitcheck - report on every git repository directly under a directory:
# whether it is linked to (and exists on) GitHub, uncommitted changes (tracked
# vs untracked), unpushed commits per branch, remote status, branches, large
# files and a summary, plus the user's GitHub repositories that are not cloned
# there.  With -i it also offers to act on them: with -c, to add or ignore
# untracked files, commit, set upstreams and push; with -u, to clone.
#
# Subdirectories that are not repositories are flagged, except names like tmp
# or BAK and any listed in ~/.config/gitcheck/ignore; -i offers to make them
# new repositories.
#
# "Don't ask again" answers to setting an upstream are kept in the repo's own
# config as branch.<name>.gitcheckNoUpstream; to cloning, in
# ~/.config/gitcheck/noclone; to flagging a directory, in
# ~/.config/gitcheck/ignore.
#
# See gitcheck.1 for the full description.  Exit status: 0 done, 2 usage error.

VERSION=1.0
PROG=${0##*/}
TTY=${GITCHECK_TTY:-/dev/tty}

usage() {
  echo "Usage: $PROG [options] [DIR]"
  echo "Check each git repository directly under DIR (default: the current directory)."
  echo "Options:"
  echo "  -u    List repositories linked to GitHub, and GitHub repositories not cloned"
  echo "        here (with -i: offer to clone them)"
  echo "  -c    Check for uncommitted changes, unpulled commits (flagging potential"
  echo "        conflicts) and unpushed commits"
  echo "  -f    Fetch first, then compare the current branch with its upstream"
  echo "  -b    List all branches"
  echo "  -l    Check for large files (>1MB)"
  echo "  -s    Display repository summary"
  echo "  -i    Interactive, with -c: add/ignore untracked files, commit, pull, push;"
  echo "        with -u: clone; either way: make non-repository directories new"
  echo "        repos (git init, commit, create on GitHub) or stop flagging them"
  echo "  -V    Show the version"
  echo "  -h    Show this help message"
  exit "${1:-2}"
}

# Prompt on the terminal (stdin may be redirected inside loops).
# Usage: ask "question" "choices"  -> sets $reply to the lowercased answer
ask() {
  local prompt=$1 choices=$2
  while true; do
    read -r -u 9 -p "  │  ? $prompt " reply || exit 1
    reply=${reply,,}
    [[ ${#reply} -eq 1 && "$choices" == *"$reply"* ]] && return
    echo "  │    Please answer one of: $choices"
  done
}

# Offer to add or ignore each untracked file/folder in repo $1
handle_untracked() {
  local dir=$1 f entry
  local -a files
  mapfile -d '' files < <(git -C "$dir" ls-files --others --exclude-standard \
                            --directory --no-empty-directory -z)
  for f in "${files[@]}"; do
    ask "Untracked '$f': [a]dd, [i]gnore, [s]kip, [q]uit?" "aisq"
    case $reply in
      a ) git -C "$dir" add -- "$f" && echo "  │    Added $f" ;;
      i ) # Anchor to repo root and escape glob characters
          entry="/$(sed 's/[][*?\\]/\\&/g' <<< "$f")"
          if [ -s "$dir/.gitignore" ] && [ -n "$(tail -c1 "$dir/.gitignore")" ]; then
            echo >> "$dir/.gitignore"
          fi
          echo "$entry" >> "$dir/.gitignore"
          git -C "$dir" add -- .gitignore
          echo "  │    Added $entry to .gitignore" ;;
      q ) exit 0 ;;
    esac
  done
}

# Offer to commit tracked changes in repo $1
handle_commit() {
  local dir=$1 changes staged msg
  changes=$(git -C "$dir" status --short --untracked-files=no)
  [ -z "$changes" ] && return
  echo "  │  Changes to commit:"
  head -n 20 <<< "$changes" | sed 's/^/  │    /'
  local total=$(wc -l <<< "$changes")
  [ "$total" -gt 20 ] && echo "  │    ... and $((total - 20)) more"

  if git -C "$dir" diff --cached --quiet; then
    ask "Commit: [a]ll tracked changes, [n]o, [q]uit?" "anq"
  else
    ask "Commit: [a]ll tracked changes, [s]taged only, [n]o, [q]uit?" "asnq"
  fi
  case $reply in
    n ) return ;;
    q ) exit 0 ;;
    a ) git -C "$dir" add -u ;;
  esac
  read -r -u 9 -p "  │  ? Commit message (empty to cancel): " msg
  if [ -z "$msg" ]; then
    echo "  │    Commit cancelled (changes left staged)"
    return
  fi
  git -C "$dir" commit -q -m "$msg" && echo "  │    Committed: $(git -C "$dir" log -1 --format='%h %s')"
}

# Highlight for warnings (potential conflicts), only on a terminal
if [ -t 1 ]; then
  WARN=$'\e[1;31m⚠ ' NORM=$'\e[0m'
else
  WARN='⚠ ' NORM=''
fi

# Print up to 5 of the newline-separated names in $1, comma-separated
list_names() {
  local n
  n=$(grep -c . <<< "$1")
  printf '%s' "$(head -n 5 <<< "$1" | paste -sd, - | sed 's/,/, /g')"
  [ "$n" -gt 5 ] && printf ' and %d more' $((n - 5))
}

# List "branch<TAB>upstream-ref" for each local branch in repo $1 whose
# upstream still exists
branches_with_upstream() {
  local b up
  while IFS=$'\t' read -r b up; do
    [ -n "$up" ] && git -C "$1" rev-parse -q --verify "$up" > /dev/null &&
      printf '%s\t%s\n' "$b" "$up"
  done < <(git -C "$1" for-each-ref --format='%(refname:short)%09%(upstream)' refs/heads)
}

# Work out how local branch $2 in repo $1 stands against its upstream $3 (as
# of the last fetch).  Sets: behind, ahead (commit counts); merge_rc (0 merges
# cleanly, 1 would conflict, other: unknown; only if both are nonzero) and
# conflicts (the files); clash (uncommitted or untracked files that the
# upstream also changed; current branch only)
pull_state() {
  local dir=$1 b=$2 up=$3 theirs ours
  behind=$(git -C "$dir" rev-list --count "refs/heads/$b..$up")
  ahead=$(git -C "$dir" rev-list --count "$up..refs/heads/$b")
  merge_rc=0 conflicts="" clash=""
  if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
    conflicts=$(git -C "$dir" merge-tree --write-tree --name-only --no-messages \
                  "refs/heads/$b" "$up" 2>/dev/null)
    merge_rc=$?
    conflicts=$(tail -n +2 <<< "$conflicts")
  fi
  if [ "$behind" -gt 0 ] && [ "$b" = "$(git -C "$dir" symbolic-ref --short -q HEAD)" ]; then
    theirs=$(git -C "$dir" diff --name-only "HEAD...$up")
    ours=$( { git -C "$dir" diff --name-only HEAD
              git -C "$dir" ls-files --others --exclude-standard; } | LC_ALL=C sort -u)
    [ -n "$theirs" ] && [ -n "$ours" ] &&
      clash=$(grep -Fx -f <(printf '%s\n' "$theirs") <<< "$ours")
  fi
  return 0
}

# Report, for each local branch in repo $1 with an upstream, commits on the
# upstream that are not in the branch (as of the last fetch), and flag
# potential conflicts: a merge of diverged branches that would conflict,
# and, on the current branch, uncommitted changes to files that the
# upstream also changed
report_unpulled() {
  local dir=$1 b up out=""
  while IFS=$'\t' read -r b up; do
    pull_state "$dir" "$b" "$up"
    [ "$behind" -gt 0 ] || continue
    out+="  │  └─ $b: $behind (from ${up#refs/remotes/})"$'\n'
    if [ "$ahead" -gt 0 ]; then
      if [ $merge_rc -eq 1 ]; then
        out+="  │     ${WARN}Diverged ($ahead local); merging would conflict in: $(list_names "$conflicts")${NORM}"$'\n'
      elif [ $merge_rc -eq 0 ]; then
        out+="  │     Diverged ($ahead local); merges cleanly"$'\n'
      else
        out+="  │     ${WARN}Diverged ($ahead local)${NORM}"$'\n'
      fi
    fi
    if [ -n "$clash" ]; then
      out+="  │     ${WARN}Uncommitted changes to files changed upstream: $(list_names "$clash")${NORM}"$'\n'
    fi
  done < <(branches_with_upstream "$dir")
  if [ -n "$out" ]; then
    echo "  ├─ Unpulled commits: Yes"
    printf '%s' "$out"
    return 0
  else
    echo "  ├─ Unpulled commits: No"
    return 1
  fi
}

# Offer to pull each branch in repo $1 that is behind its upstream, where it
# can be done safely: a fast-forward, or (current branch only) a merge or
# rebase that merge-tree says will not conflict.  Never when uncommitted
# changes touch files the upstream changed.
handle_pull() {
  local dir=$1 b up target cur pair
  local -a pairs
  mapfile -t pairs < <(branches_with_upstream "$dir")
  for pair in "${pairs[@]}"; do
    b=${pair%%$'\t'*} up=${pair#*$'\t'} target=${up#refs/remotes/}
    pull_state "$dir" "$b" "$up"
    [ "$behind" -gt 0 ] || continue
    cur=$(git -C "$dir" symbolic-ref --short -q HEAD)
    if [ -n "$clash" ]; then
      echo "  │    Not pulling '$b': commit or stash the changes to $(list_names "$clash") first"
      continue
    fi
    if [ "$ahead" -eq 0 ]; then
      ask "Pull $behind commit(s) from $target into '$b' (fast-forward)? [y]es, [n]o, [q]uit" "ynq"
      case $reply in
        y ) if [ "$b" = "$cur" ]; then
              git -C "$dir" merge -q --ff-only "$up"
            else
              git -C "$dir" fetch -q . "$up:refs/heads/$b"
            fi && echo "  │    '$b' is now at $(git -C "$dir" log -1 --format='%h %s' "refs/heads/$b")" ;;
        q ) exit 0 ;;
      esac
    elif [ "$b" != "$cur" ]; then
      echo "  │    Not pulling '$b': it has diverged and is not checked out"
    elif [ $merge_rc -ne 0 ]; then
      echo "  │    Not pulling '$b': it has diverged and would not merge cleanly; resolve by hand"
    else
      ask "'$b' has diverged from $target ($ahead local, $behind remote). [m]erge, [r]ebase, [n]o, [q]uit?" "mrnq"
      case $reply in
        m ) if git -C "$dir" merge -q --no-edit "$up"; then
              echo "  │    Merged $target into '$b'"
            else
              git -C "$dir" merge --abort 2>/dev/null; echo "  │    Merge failed; aborted"
            fi ;;
        r ) if git -C "$dir" rebase -q --autostash "$up"; then
              echo "  │    Rebased '$b' onto $target"
            else
              git -C "$dir" rebase --abort 2>/dev/null; echo "  │    Rebase failed; aborted"
            fi ;;
        q ) exit 0 ;;
      esac
    fi
  done
}

# Per-branch git config key recording "never set an upstream for this branch"
NO_UPSTREAM_KEY=gitcheckNoUpstream

# True if branch $2 in repo $1 was marked as never needing an upstream
is_local_only() {
  [ "$(git -C "$1" config --bool "branch.$2.$NO_UPSTREAM_KEY")" = true ]
}

# Offer to set upstreams, then to push, for each local branch in repo $1
# that has unpushed commits
handle_push() {
  local dir=$1 b n remote merge
  local -a branches
  mapfile -t branches < <(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads)
  for b in "${branches[@]}"; do
    n=$(git -C "$dir" rev-list --count "refs/heads/$b" --not --remotes 2>/dev/null)
    [ -n "$n" ] && [ "$n" -gt 0 ] || continue
    is_local_only "$dir" "$b" && continue
    remote=$(git -C "$dir" config "branch.$b.remote")
    merge=$(git -C "$dir" config "branch.$b.merge")

    # No upstream: ask whether to set one (no push yet)
    if [ -z "$remote" ] || [ -z "$merge" ]; then
      remote=$(git -C "$dir" remote | grep -qx origin && echo origin || git -C "$dir" remote | head -n 1)
      if [ -z "$remote" ]; then
        echo "  │    '$b' has $n unpushed commit(s) but no remote is configured"
        continue
      fi
      ask "'$b' has no upstream. Set it to $remote/$b? [y]es, [n]o (don't ask again), [s]kip, [q]uit" "ynsq"
      case $reply in
        y ) merge="refs/heads/$b"
            git -C "$dir" config "branch.$b.remote" "$remote"
            git -C "$dir" config "branch.$b.merge" "$merge"
            echo "  │    Upstream of '$b' set to $remote/$b" ;;
        n ) git -C "$dir" config --bool "branch.$b.$NO_UPSTREAM_KEY" true
            echo "  │    '$b' marked local-only (undo: git config --unset branch.$b.$NO_UPSTREAM_KEY)"
            continue ;;
        s ) continue ;;
        q ) exit 0 ;;
      esac
    fi

    ask "Push $n commit(s) on '$b' to $remote/${merge#refs/heads/}? [y]es, [n]o, [q]uit" "ynq"
    case $reply in
      y ) git -C "$dir" push "$remote" "refs/heads/$b:$merge" ;;
      q ) exit 0 ;;
    esac
  done
}

CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/gitcheck

# Directories that are not git repositories and should not be flagged:
# built-in name patterns (any case), plus IGNORE_FILE, one per line: a name
# pattern, or an absolute path (pattern) for one particular directory
DEFAULT_IGNORE=(tmp temp bak backup backups old trash cache '*.bak' '*.old' '*~')
IGNORE_FILE=$CONF_DIR/ignore

# True if non-repository directory $1 (in the current directory) is ignored
is_ignored() {
  local name=$1 path=$top/$1 pat
  shopt -s nocasematch
  for pat in "${DEFAULT_IGNORE[@]}"; do
    if [[ $name == $pat ]]; then shopt -u nocasematch; return 0; fi
  done
  shopt -u nocasematch
  [ -f "$IGNORE_FILE" ] || return 1
  while IFS= read -r pat; do
    [[ -z $pat || $pat == \#* ]] && continue
    if [[ $pat == /* ]]; then
      [[ $path == $pat ]] && return 0
    else
      [[ $name == $pat ]] && return 0
    fi
  done < "$IGNORE_FILE"
  return 1
}

# Make directory $1 a new repository: git init, add/ignore its files, an
# initial commit, and optionally a new GitHub repository to push it to
handle_new_repo() {
  local dir=$1 vis
  git init -q -- "$dir" || return
  echo "  │    Initialized a git repository in $dir"
  handle_untracked "$dir"
  handle_commit "$dir"
  [ "$have_gh" = true ] || return
  if grep -qxF -- "$dir" <<< "$repos"; then
    echo "  │    $owner/$dir already exists on GitHub; not creating it"
    return
  fi
  ask "Create GitHub repository $owner/$dir? [p]rivate, p[u]blic, [n]o, [q]uit" "punq"
  case $reply in
    p ) vis=--private ;;
    u ) vis=--public ;;
    n ) return ;;
    q ) exit 0 ;;
  esac
  if git -C "$dir" rev-parse -q --verify HEAD > /dev/null; then
    gh repo create "$dir" "$vis" --source "$dir" --remote origin --push
  else
    gh repo create "$dir" "$vis" --source "$dir" --remote origin
  fi
}

# Offer to make non-repository directory $1 a repository, or stop flagging it
handle_not_repo() {
  ask "Not a git repository. [g]it init (new repo), [i]gnore from now on, [s]kip, [q]uit?" "gisq"
  case $reply in
    g ) handle_new_repo "$1" ;;
    i ) mkdir -p "$CONF_DIR" &&
        printf '%s\n' "$top/$1" | sed 's/[][*?\\]/\\&/g' >> "$IGNORE_FILE" &&
        echo "  │    Won't flag it again (undo: remove it from $IGNORE_FILE)" ;;
    q ) exit 0 ;;
  esac
}

# GitHub repositories (owner/name, one per line) never to offer to clone
NOCLONE_FILE=$CONF_DIR/noclone

is_noclone() {
  [ -f "$NOCLONE_FILE" ] && grep -qxF -- "$1" "$NOCLONE_FILE"
}

# Offer to clone each GitHub repository in the array named $1 into the
# current directory
handle_clone() {
  local -n names=$1
  local name
  for name in "${names[@]}"; do
    is_noclone "$owner/$name" && continue
    ask "Clone $owner/$name? [y]es, [n]o (don't ask again), [s]kip, [q]uit" "ynsq"
    case $reply in
      y ) gh repo clone "$owner/$name" "$name" ;;
      n ) mkdir -p "$(dirname "$NOCLONE_FILE")" &&
          echo "$owner/$name" >> "$NOCLONE_FILE" &&
          echo "  │    Won't ask again (undo: remove it from $NOCLONE_FILE)" ;;
      q ) exit 0 ;;
    esac
  done
}

# Flags
list_repos=false
check_changes=false
fetch_compare=false
list_branches=false
check_large_files=false
display_summary=false
interactive=false

# Parse options
while getopts "ucfblsiVh" opt; do
  case ${opt} in
    u ) list_repos=true ;;
    c ) check_changes=true ;;
    f ) fetch_compare=true ;;
    b ) list_branches=true ;;
    l ) check_large_files=true ;;
    s ) display_summary=true ;;
    i ) interactive=true ;;
    V ) echo "$PROG $VERSION"; exit 0 ;;
    h ) usage 0 ;;
    * ) usage ;;
  esac
done

# If no options provided, show usage
if [ $OPTIND -eq 1 ]; then
    usage
fi
if [ "$interactive" = true ] && [ "$check_changes" != true ] && [ "$list_repos" != true ]; then
  echo "$PROG: -i needs -c and/or -u" >&2
  usage
fi
shift $((OPTIND - 1))
[ $# -gt 1 ] && usage
# Answers are read on fd 9, opened once (stdin may be redirected inside loops)
if [ "$interactive" = true ]; then
  exec 9< "$TTY" || exit 1
fi
if [ $# -eq 1 ]; then
  cd -- "$1" || exit 2
fi
top=$(pwd -P)

# List the signed-in user's GitHub repositories (skipped without gh)
have_gh=false
if command -v gh &> /dev/null &&
   owner=$(gh api user --jq .login 2>/dev/null) && [ -n "$owner" ]; then
  have_gh=true
  repos=$(gh repo list "$owner" --limit 1000 --json name --jq '.[].name')
fi

# Process each directory
for dir in */; do
  # Remove trailing slash
  dir=${dir%/}
  
  # Skip if not a directory
  [ ! -d "$dir" ] && continue
  
  if [ -e "$dir/.git" ]; then
    echo "Processing $dir..."

    # -f: fetch first, so the -c and -f checks see the remotes as they are now
    if [ "$fetch_compare" = true ] && git -C "$dir" remote | grep -q .; then
      git -C "$dir" fetch --all -q &>/dev/null ||
        echo "  ├─ ${WARN}Fetch failed${NORM}"
    fi

    # Check GitHub connection
    if git -C "$dir" remote -v | grep -q 'github.com'; then
      echo -n "  ├─ Linked to GitHub: "
      if [ "$have_gh" != true ]; then
        echo "Yes"
      elif grep -qxF -- "$dir" <<< "$repos"; then
        echo "Yes (exists on GitHub)"
      else
        echo "Yes (but NOT on GitHub)"
      fi
    else
      echo "  ├─ Linked to GitHub: No"
    fi
    
    # Check for uncommitted changes
    if [ "$check_changes" = true ]; then
      status=$(git -C "$dir" status --porcelain)
      if [ -n "$status" ]; then
        branch=$(git -C "$dir" symbolic-ref --short -q HEAD ||
                 echo "detached at $(git -C "$dir" rev-parse --short HEAD 2>/dev/null)")
        tracked=$(grep -vc '^??' <<< "$status")
        untracked=$(grep -c '^??' <<< "$status")
        echo "  ├─ Uncommitted changes: Yes (branch: $branch)"
        echo "  │  ├─ Tracked files changed: $tracked"
        echo "  │  └─ Untracked files: $untracked"
        if [ "$interactive" = true ]; then
          handle_untracked "$dir"
          handle_commit "$dir"
        fi
      else
        echo "  ├─ Uncommitted changes: No"
      fi

      if report_unpulled "$dir" && [ "$interactive" = true ]; then
        handle_pull "$dir"
      fi

      # Commits on local branches that are on no remote-tracking branch
      unpushed=""
      while IFS= read -r b; do
        n=$(git -C "$dir" rev-list --count "refs/heads/$b" --not --remotes 2>/dev/null)
        if [ -n "$n" ] && [ "$n" -gt 0 ]; then
          unpushed+="  │  └─ $b: $n"
          is_local_only "$dir" "$b" && unpushed+=" (local only)"
          unpushed+=$'\n'
        fi
      done < <(git -C "$dir" for-each-ref --format='%(refname:short)' refs/heads)
      if [ -n "$unpushed" ]; then
        echo "  ├─ Unpushed commits: Yes"
        printf '%s' "$unpushed"
        [ "$interactive" = true ] && handle_push "$dir"
      else
        echo "  ├─ Unpushed commits: No"
      fi
    fi
    
    # Fetch and compare commits
    if [ "$fetch_compare" = true ]; then
      echo -n "  ├─ Remote status: "
      if ! git -C "$dir" remote | grep -q .; then
        echo "No remotes configured"
      else
        if ! git -C "$dir" rev-parse @{u} &>/dev/null; then
          echo "No upstream branch set"
        else
          local_branch=$(git -C "$dir" rev-parse @)
          remote_branch=$(git -C "$dir" rev-parse @{u})
          base_branch=$(git -C "$dir" merge-base @ @{u})
          
          if [ "$local_branch" = "$remote_branch" ]; then
            echo "Up to date"
          elif [ "$local_branch" = "$base_branch" ]; then
            echo "Behind remote"
          elif [ "$remote_branch" = "$base_branch" ]; then
            echo "Ahead of remote"
          else
            echo "Diverged from remote"
          fi
        fi
      fi
    fi
    
    # List branches
    if [ "$list_branches" = true ]; then
      echo "  ├─ Branches:"
      git -C "$dir" branch -a | sed 's/^/  │  /'
    fi
    
    # Check for large files
    if [ "$check_large_files" = true ]; then
      echo "  ├─ Checking for large files (>1MB)..."
      # ls-tree -l: "<mode> <type> <object> <size>\t<path>"
      git -C "$dir" ls-tree -r -l HEAD 2>/dev/null |
        awk -F '\t' '{ split($1, f, " ") }
                     f[4] != "-" && f[4] >= 1000000 {
                       printf "  │  └─ %s: %.2fMB\n", $2, f[4] / 1000000 }'
    fi
    
    # Display repository summary
    if [ "$display_summary" = true ]; then
      echo "  └─ Summary:"
      commit_count=$(git -C "$dir" rev-list --all --count)
      branch_count=$(git -C "$dir" branch | wc -l)
      recent_activity=$(git -C "$dir" log -1 --format="%cd" --date=relative 2>/dev/null || echo "No commits")
      echo "      Commits: $commit_count"
      echo "      Branches: $branch_count"
      echo "      Last commit: $recent_activity"
    fi
    
    echo ""
  elif ! is_ignored "$dir"; then
    echo "$dir: Not a Git repository"
    [ "$interactive" = true ] && handle_not_repo "$dir"
    echo ""
  fi
done

# GitHub repositories with no local directory of the same name
if [ "$list_repos" = true ]; then
  if [ "$have_gh" != true ]; then
    echo "GitHub repositories not cloned here: unknown (gh is not installed or not signed in)"
  else
    missing=()
    while IFS= read -r name; do
      [ -z "$name" ] || [ -e "$name" ] || missing+=("$name")
    done <<< "$repos"
    if [ ${#missing[@]} -eq 0 ]; then
      echo "GitHub repositories not cloned here: None"
    else
      echo "GitHub repositories not cloned here:"
      for name in "${missing[@]}"; do
        if is_noclone "$owner/$name"; then
          echo "  └─ $name (don't clone)"
        else
          echo "  └─ $name"
        fi
      done
      if [ "$interactive" = true ]; then
        handle_clone missing
      fi
    fi
  fi
fi
exit 0
