#!/usr/bin/env bash
# gitcheck - report on every git repository directly under a directory:
# whether it is linked to (and exists on) GitHub, uncommitted changes (tracked
# vs untracked), unpushed commits per branch, remote status, branches, large
# files and a summary, plus the user's GitHub repositories that are not cloned
# there.  With -i it also offers to act on them: with -c, to add or ignore
# untracked files, commit, set upstreams and push; with -u, to clone.
#
# Subdirectories that are not repositories are flagged, except names like tmp
# or BAK and any listed in ~/.config/gitcheck/ignore; -i offers to make them
# new repositories.
#
# For a branch with no upstream it can also merge the branch into the main
# branch, or delete it when its commits are already there.  A repository with no
# remote can be marked local-only (git config gitcheck.localOnly true): its
# unpushed commits are then not flagged.  And with -c, if DIR
# has a non-empty tmp-branches.txt and a clean-up-branches.sh, it says so and (with
# -i) offers to run that script first.
#
# "Don't ask again" answers to setting an upstream are kept in the repo's own
# config as branch.<name>.gitcheckNoUpstream; to cloning, in
# ~/.config/gitcheck/noclone; to flagging a directory, in
# ~/.config/gitcheck/ignore.
#
# With -c every repository is fetched (with --prune) first, so unpulled and unpushed
# commits are judged against the remotes as they are now; -N skips that.  A branch is
# never offered a push while it is behind its upstream: pull first.
#
# See gitcheck.1 for the full description.  Exit status: 0 done, 1 could not read an
# answer, 2 usage error.

VERSION=1.0
PROG=${0##*/}
TTY=${GITCHECK_TTY:-/dev/tty}

usage() {
  echo "Usage: $PROG [options] [DIR]"
  echo "Check each git repository directly under DIR (default: the current directory)."
  echo "Options:"
  echo "  -u    List GitHub repositories not cloned here (with -i: offer to clone them)"
  echo "  -c    Fetch, then check for uncommitted changes, unpulled commits (flagging"
  echo "        potential conflicts) and unpushed commits"
  echo "  -f    Fetch, then compare the current branch with its upstream"
  echo "  -N    Do not fetch (with -c/-f): use the remotes as of the last fetch"
  echo "  -b    List all branches"
  echo "  -l    Check for large files (>1MB)"
  echo "  -s    Display repository summary"
  echo "  -i    Interactive, with -c: add/ignore untracked files, commit, pull, push;"
  echo "        with -u: clone; either way: make non-repository directories new"
  echo "        repos (git init, commit, create on GitHub) or stop flagging them"
  echo "  -V    Show the version"
  echo "  -h    Show this help message"
  exit "${1:-2}"
}

# Prompt on the terminal (stdin may be redirected inside loops).
# Usage: ask "question" "choices"  -> sets $reply to the lowercased answer
ask() {
  local prompt=$1 choices=$2
  while true; do
    read -r -u 9 -p "  │  ? $prompt " reply || exit 1
    reply=${reply,,}
    [[ ${#reply} -eq 1 && "$choices" == *"$reply"* ]] && return
    echo "  │    Please answer one of: $choices"
  done
}

# Offer to add or ignore each untracked file/folder in repo $1
handle_untracked() {
  local dir=$1 f entry pad
  local -a files
  mapfile -d '' files < <(git -C "$dir" ls-files --others --exclude-standard \
                            --directory --no-empty-directory -z)
  for f in "${files[@]}"; do
    ask "Untracked '$f': [a]dd, [i]gnore, [s]kip, [q]uit?" "aisq"
    case $reply in
      a ) git -C "$dir" add -- ":(literal)$f" && echo "  │    Added $f" ;;
      i ) # Anchor to repo root and escape glob characters
          entry="/$(sed 's/[][*?\\]/\\&/g' <<< "$f")"
          pad=                    # trailing spaces would be dropped, so escape them
          while [[ $entry == *' ' ]]; do entry=${entry% } pad+='\ '; done
          entry+=$pad
          if [ -s "$dir/.gitignore" ] && [ -n "$(tail -c1 "$dir/.gitignore")" ]; then
            echo >> "$dir/.gitignore"
          fi
          echo "$entry" >> "$dir/.gitignore"
          git -C "$dir" add -- .gitignore
          echo "  │    Added $entry to .gitignore" ;;
      q ) exit 0 ;;
    esac
  done
}

# Offer to commit tracked changes in repo $1
handle_commit() {
  local dir=$1 changes staged msg
  changes=$(git -C "$dir" status --short --untracked-files=no)
  [ -z "$changes" ] && return
  echo "  │  Changes to commit:"
  head -n 20 <<< "$changes" | sed 's/^/  │    /'
  local total=$(wc -l <<< "$changes")
  [ "$total" -gt 20 ] && echo "  │    ... and $((total - 20)) more"

  if git -C "$dir" diff --cached --quiet; then
    ask "Commit: [a]ll tracked changes, [n]o, [q]uit?" "anq"
  else
    ask "Commit: [a]ll tracked changes, [s]taged only, [n]o, [q]uit?" "asnq"
  fi
  case $reply in
    n ) return ;;
    q ) exit 0 ;;
    a ) git -C "$dir" add -u ;;
  esac
  read -r -u 9 -p "  │  ? Commit message (empty to cancel): " msg
  if [ -z "$msg" ]; then
    echo "  │    Commit cancelled (changes left staged)"
    return
  fi
  git -C "$dir" commit -q -m "$msg" && echo "  │    Committed: $(git -C "$dir" log -1 --format='%h %s')"
}

# Highlight for warnings (potential conflicts), only on a terminal
if [ -t 1 ]; then
  WARN=$'\e[1;31m⚠ ' NORM=$'\e[0m'
else
  WARN='⚠ ' NORM=''
fi

# Print up to 5 of the newline-separated names in $1, comma-separated
list_names() {
  local n
  n=$(grep -c . <<< "$1")
  printf '%s' "$(head -n 5 <<< "$1" | paste -sd, - | sed 's/,/, /g')"
  [ "$n" -gt 5 ] && printf ' and %d more' $((n - 5))
}

# The remote repo $1 talks to by default: origin, else the first one
default_remote() {
  local r
  r=$(git -C "$1" remote)
  if grep -qx origin <<< "$r"; then echo origin; else head -n 1 <<< "$r"; fi
}

# Print the remote-tracking ref (refs/remotes/...) that local branch $2 of repo $1 is
# compared with: its upstream if that still exists, else, unless the branch was marked
# local-only, a branch of the same name on the default remote; nothing if neither
branch_upstream() {
  local dir=$1 b=$2 up remote
  up=$(git -C "$dir" for-each-ref --format='%(upstream)' "refs/heads/$b")
  if [[ $up == refs/remotes/* ]] && git -C "$dir" rev-parse -q --verify "$up" > /dev/null; then
    echo "$up"
    return 0
  fi
  is_local_only "$dir" "$b" && return 0
  remote=$(default_remote "$dir")
  [ -n "$remote" ] || return 0
  up=refs/remotes/$remote/$b
  git -C "$dir" rev-parse -q --verify "$up" > /dev/null && echo "$up"
  return 0
}

# List "branch<TAB>upstream-ref" for each local branch in repo $1 that has one
branches_with_upstream() {
  local b up
  while IFS= read -r b; do
    up=$(branch_upstream "$1" "$b")
    [ -n "$up" ] && printf '%s\t%s\n' "$b" "$up"
  done < <(git -C "$1" for-each-ref --format='%(refname:lstrip=2)' refs/heads)
}

# Print how many commits of local branch $2 in repo $1 are not yet pushed: those not
# on its upstream, or, with none, on no remote-tracking branch at all.  Prints nothing
# if git could not count them.
unpushed_count() {
  local dir=$1 b=$2 up
  up=$(branch_upstream "$dir" "$b")
  if [ -n "$up" ]; then
    git -C "$dir" rev-list --count "$up..refs/heads/$b" 2>/dev/null
  else
    git -C "$dir" rev-list --count "refs/heads/$b" --not --remotes 2>/dev/null
  fi
}

# Print the path of another worktree of repo $1 that has branch $2 checked out
# (git will not move or delete a branch that is checked out elsewhere)
other_worktree() {
  local dir=$1 b=$2 here line wt=""
  here=$(git -C "$dir" rev-parse --show-toplevel)
  while IFS= read -r line; do
    case $line in
      "worktree "* ) wt=${line#worktree } ;;
      "branch refs/heads/$b" ) [ "$wt" != "$here" ] && { printf '%s\n' "$wt"; return 0; } ;;
    esac
  done < <(git -C "$dir" worktree list --porcelain)
  return 1
}

# Work out how local branch $2 in repo $1 stands against its upstream $3 (as
# of the last fetch).  Sets: behind, ahead (commit counts); merge_rc (0 merges
# cleanly, 1 would conflict, other: unknown; only if both are nonzero) and
# conflicts (the files); clash (uncommitted or untracked files that the
# upstream also changed; current branch only)
pull_state() {
  local dir=$1 b=$2 up=$3 theirs ours
  behind=$(git -C "$dir" rev-list --count "refs/heads/$b..$up")
  ahead=$(git -C "$dir" rev-list --count "$up..refs/heads/$b")
  merge_rc=0 conflicts="" clash=""
  if [ "$behind" -gt 0 ] && [ "$ahead" -gt 0 ]; then
    conflicts=$(git -C "$dir" merge-tree --write-tree --name-only --no-messages \
                  "refs/heads/$b" "$up" 2>/dev/null)
    merge_rc=$?
    conflicts=$(tail -n +2 <<< "$conflicts")
  fi
  if [ "$behind" -gt 0 ] && [ "$b" = "$(git -C "$dir" symbolic-ref --short -q HEAD)" ]; then
    theirs=$(git -C "$dir" diff --name-only "HEAD...$up")
    ours=$( { git -C "$dir" diff --name-only HEAD
              git -C "$dir" ls-files --others --exclude-standard; } | LC_ALL=C sort -u)
    [ -n "$theirs" ] && [ -n "$ours" ] &&
      clash=$(grep -Fx -f <(printf '%s\n' "$theirs") <<< "$ours")
  fi
  return 0
}

# Report, for each local branch in repo $1 with an upstream, commits on the
# upstream that are not in the branch (as of the last fetch), and flag
# potential conflicts: a merge of diverged branches that would conflict,
# and, on the current branch, uncommitted changes to files that the
# upstream also changed
report_unpulled() {
  local dir=$1 b up out=""
  while IFS=$'\t' read -r b up; do
    pull_state "$dir" "$b" "$up"
    [ "$behind" -gt 0 ] || continue
    out+="  │  └─ $b: $behind (from ${up#refs/remotes/})"$'\n'
    if [ "$ahead" -gt 0 ]; then
      if [ $merge_rc -eq 1 ]; then
        out+="  │     ${WARN}Diverged ($ahead local); merging would conflict in: $(list_names "$conflicts")${NORM}"$'\n'
      elif [ $merge_rc -eq 0 ]; then
        out+="  │     Diverged ($ahead local); merges cleanly"$'\n'
      else
        out+="  │     ${WARN}Diverged ($ahead local)${NORM}"$'\n'
      fi
    fi
    if [ -n "$clash" ]; then
      out+="  │     ${WARN}Uncommitted changes to files changed upstream: $(list_names "$clash")${NORM}"$'\n'
    fi
  done < <(branches_with_upstream "$dir")
  if [ -n "$out" ]; then
    echo "  ├─ Unpulled commits: Yes"
    printf '%s' "$out"
    return 0
  else
    echo "  ├─ Unpulled commits: No"
    return 1
  fi
}

# Offer to pull each branch in repo $1 that is behind its upstream, where it
# can be done safely: a fast-forward, or (current branch only) a merge or
# rebase that merge-tree says will not conflict.  Never when uncommitted
# changes touch files the upstream changed.
handle_pull() {
  local dir=$1 pair
  local -a pairs
  mapfile -t pairs < <(branches_with_upstream "$dir")
  for pair in "${pairs[@]}"; do
    pull_branch "$dir" "${pair%%$'\t'*}" "${pair#*$'\t'}"
  done
}

# The offer to pull branch $2 of repo $1 from its upstream $3 (a refs/remotes/ ref)
pull_branch() {
  local dir=$1 b=$2 up=$3 target=${3#refs/remotes/} cur wt
  pull_state "$dir" "$b" "$up"
  [ "$behind" -gt 0 ] || return 0
  cur=$(git -C "$dir" symbolic-ref --short -q HEAD)
  if [ -n "$clash" ]; then
    echo "  │    Not pulling '$b': commit or stash the changes to $(list_names "$clash") first"
    return 0
  fi
  if [ "$b" != "$cur" ] && wt=$(other_worktree "$dir" "$b"); then
    echo "  │    Not pulling '$b': it is checked out in $wt; pull there"
    return 0
  fi
  if [ "$ahead" -eq 0 ]; then
    ask "Pull $behind commit(s) from $target into '$b' (fast-forward)? [y]es, [n]o, [q]uit" "ynq"
    case $reply in
      y ) if [ "$b" = "$cur" ]; then
            git -C "$dir" merge -q --ff-only "$up"
          else
            git -C "$dir" fetch -q . "$up:refs/heads/$b"
          fi && echo "  │    '$b' is now at $(git -C "$dir" log -1 --format='%h %s' "refs/heads/$b")" ;;
      q ) exit 0 ;;
    esac
  elif [ "$b" != "$cur" ]; then
    echo "  │    Not pulling '$b': it has diverged and is not checked out"
  elif [ $merge_rc -eq 1 ]; then
    echo "  │    Not pulling '$b': it has diverged and would not merge cleanly; resolve by hand"
  elif [ $merge_rc -ne 0 ]; then
    echo "  │    Not pulling '$b': it has diverged and git could not tell whether it merges cleanly; resolve by hand"
  else
    ask "'$b' has diverged from $target ($ahead local, $behind remote). [m]erge, [r]ebase, [n]o, [q]uit?" "mrnq"
    case $reply in
      m ) if git -C "$dir" merge -q --no-edit -m "Merge $target into $b" "$up"; then
            echo "  │    Merged $target into '$b'"
          else
            git -C "$dir" merge --abort 2>/dev/null; echo "  │    Merge failed; aborted"
          fi ;;
      r ) if git -C "$dir" rebase -q --autostash "$up"; then
            echo "  │    Rebased '$b' onto $target"
          else
            git -C "$dir" rebase --abort 2>/dev/null; echo "  │    Rebase failed; aborted"
          fi ;;
      q ) exit 0 ;;
    esac
  fi
}

# Per-branch git config key recording "never set an upstream for this branch"
NO_UPSTREAM_KEY=gitcheckNoUpstream

# Per-repository config key recording "this repository is local-only": it is not
# checked for unpushed commits (set by answering y for a repository with no remote,
# or by hand: git config --bool gitcheck.localOnly true)
LOCAL_ONLY_KEY=gitcheck.localOnly

# True if repository $1 was marked local-only
is_local_only_repo() {
  [ "$(git -C "$1" config --bool "$LOCAL_ONLY_KEY")" = true ]
}

# True if branch $2 in repo $1 was marked as never needing an upstream
is_local_only() {
  [ "$(git -C "$1" config --bool "branch.$2.$NO_UPSTREAM_KEY")" = true ]
}

# The main branch of repo $1: what origin/HEAD points to, else main, else master
# (only if it exists locally); prints nothing when there is none
default_branch() {
  local dir=$1 d
  d=$(git -C "$dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)
  d=${d#*/}
  if [ -n "$d" ] && git -C "$dir" show-ref -q --verify "refs/heads/$d"; then echo "$d"; return; fi
  for d in main master; do
    if git -C "$dir" show-ref -q --verify "refs/heads/$d"; then echo "$d"; return; fi
  done
}

# Merge branch $2 into the main branch $3 of repo $1: a fast-forward where that
# is all it takes, else a real merge, but only while $3 is checked out (a merge
# needs the working tree).  Returns non-zero, after saying why, if it did not merge.
merge_into_default() {
  local dir=$1 b=$2 def=$3 cur wt
  cur=$(git -C "$dir" symbolic-ref -q --short HEAD)
  if [ "$cur" != "$def" ] && wt=$(other_worktree "$dir" "$def"); then
    echo "  │    Not merging '$b': '$def' is checked out in $wt; merge there"
    return 1
  fi
  if git -C "$dir" merge-base --is-ancestor "refs/heads/$def" "refs/heads/$b"; then
    if [ "$cur" = "$def" ]; then
      git -C "$dir" merge -q --ff-only "refs/heads/$b" || return 1
    else
      git -C "$dir" fetch -q . "refs/heads/$b:refs/heads/$def" || return 1
    fi
    echo "  │    Fast-forwarded '$def' to '$b'"
  elif [ "$cur" != "$def" ]; then
    echo "  │    Not merging '$b': '$def' has moved on and is not checked out (check it out first)"
    return 1
  elif git -C "$dir" merge -q --no-edit "refs/heads/$b"; then
    echo "  │    Merged '$b' into '$def'"
  else
    git -C "$dir" merge --abort 2>/dev/null
    echo "  │    Merging '$b' into '$def' failed (conflicts?); aborted, nothing changed"
    return 1
  fi
}

# Delete branch $2 of repo $1 (its commits are known to be elsewhere) and print $3,
# unless the branch is checked out somewhere, where git would refuse
delete_branch() {
  local dir=$1 b=$2 wt
  if [ "$b" = "$(git -C "$dir" symbolic-ref -q --short HEAD)" ]; then
    echo "  │    Not deleting '$b': it is checked out"
  elif wt=$(other_worktree "$dir" "$b"); then
    echo "  │    Not deleting '$b': it is checked out in $wt"
  else
    git -C "$dir" branch -D "$b" > /dev/null && echo "$3"
  fi
}

# Offer to set upstreams (or merge a branch into the main branch, or delete one
# already merged), then to push, for each local branch in repo $1 that has
# unpushed commits
handle_push() {
  local dir=$1 b n remote merge def state up wt
  local -a branches
  mapfile -t branches < <(git -C "$dir" for-each-ref --format='%(refname:lstrip=2)' refs/heads)

  # A repository with no remote at all has nowhere to push: offer to mark the whole
  # repository local-only (once), unless every unpushed branch is already marked
  if ! git -C "$dir" remote | grep -q .; then
    local open=false
    for b in "${branches[@]}"; do
      n=$(unpushed_count "$dir" "$b")
      [ -n "$n" ] && [ "$n" -gt 0 ] && ! is_local_only "$dir" "$b" && open=true
    done
    [ "$open" = true ] || return 0
    ask "'${dir##*/}' has no remote. Mark the repository local-only, so its unpushed commits are no longer flagged? [y]es, [s]kip, [q]uit" "ysq"
    case $reply in
      y ) git -C "$dir" config --bool "$LOCAL_ONLY_KEY" true
          echo "  │    '${dir##*/}' marked local-only (undo: git config --unset $LOCAL_ONLY_KEY)" ;;
      q ) exit 0 ;;
    esac
    return 0
  fi

  for b in "${branches[@]}"; do
    n=$(unpushed_count "$dir" "$b")
    [ -n "$n" ] && [ "$n" -gt 0 ] || continue
    is_local_only "$dir" "$b" && continue
    remote=$(git -C "$dir" config "branch.$b.remote")
    merge=$(git -C "$dir" config "branch.$b.merge")

    # No upstream: ask whether to set one (no push yet)
    if [ -z "$remote" ] || [ -z "$merge" ]; then
      remote=$(default_remote "$dir")
      if [ -z "$remote" ]; then
        echo "  │    '$b' has $n unpushed commit(s) but no remote is configured"
        continue
      fi
      # Is the branch's work already in the main branch, or could it be merged there?
      def=$(default_branch "$dir")
      state=none
      if [ -n "$def" ] && [ "$b" != "$def" ]; then
        if git -C "$dir" merge-base --is-ancestor "refs/heads/$b" "refs/heads/$def"; then
          state=merged
        else
          state=unmerged
        fi
      fi
      case $state in
        merged )   ask "'$b' has no upstream, but its commits are already in '$def'. [d]elete the branch, [y]es set upstream $remote/$b anyway, [n]o (don't ask again), [s]kip, [q]uit" "ydnsq" ;;
        unmerged ) ask "'$b' has no upstream. Set it to $remote/$b? [y]es, [m]erge it into '$def' instead, [n]o (don't ask again), [s]kip, [q]uit" "ymnsq" ;;
        * )        ask "'$b' has no upstream. Set it to $remote/$b? [y]es, [n]o (don't ask again), [s]kip, [q]uit" "ynsq" ;;
      esac
      case $reply in
        y ) merge="refs/heads/$b"
            git -C "$dir" config "branch.$b.remote" "$remote"
            git -C "$dir" config "branch.$b.merge" "$merge"
            echo "  │    Upstream of '$b' set to $remote/$b" ;;
        d ) # every commit of the branch is reachable from $def, so -D loses nothing
            delete_branch "$dir" "$b" "  │    Deleted '$b' (its commits are in '$def')"
            continue ;;
        m ) if merge_into_default "$dir" "$b" "$def"; then
              ask "Delete the merged branch '$b'? [y]es, [n]o (keep it)" "yn"
              [ "$reply" = y ] && delete_branch "$dir" "$b" "  │    Deleted '$b'"
            fi
            continue ;;
        n ) git -C "$dir" config --bool "branch.$b.$NO_UPSTREAM_KEY" true
            echo "  │    '$b' marked local-only (undo: git config --unset branch.$b.$NO_UPSTREAM_KEY)"
            continue ;;
        s ) continue ;;
        q ) exit 0 ;;
      esac
    fi

    # Pull before pushing: a branch that is behind its upstream would be rejected, or
    # (forced) would lose the commits it lacks
    up=$(branch_upstream "$dir" "$b")
    if [ -n "$up" ]; then
      pull_state "$dir" "$b" "$up"
      if [ "$behind" -gt 0 ]; then
        echo "  │    Not pushing '$b': it is $behind commit(s) behind ${up#refs/remotes/}; pull first"
        continue
      fi
    fi

    ask "Push $n commit(s) on '$b' to $remote/${merge#refs/heads/}? [y]es, [n]o, [q]uit" "ynq"
    case $reply in
      y ) git -C "$dir" push "$remote" "refs/heads/$b:$merge" ;;
      q ) exit 0 ;;
    esac
  done
}

CONF_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/gitcheck

# Directories that are not git repositories and should not be flagged:
# built-in name patterns (any case), plus IGNORE_FILE, one per line: a name
# pattern, or an absolute path (pattern) for one particular directory
DEFAULT_IGNORE=(tmp temp bak backup backups old trash cache '*.bak' '*.old' '*~')
IGNORE_FILE=$CONF_DIR/ignore

# True if non-repository directory $1 (in the current directory) is ignored
is_ignored() {
  local name=$1 path=$top/$1 pat
  shopt -s nocasematch
  for pat in "${DEFAULT_IGNORE[@]}"; do
    if [[ $name == $pat ]]; then shopt -u nocasematch; return 0; fi
  done
  shopt -u nocasematch
  [ -f "$IGNORE_FILE" ] || return 1
  while IFS= read -r pat; do
    [[ -z $pat || $pat == \#* ]] && continue
    if [[ $pat == /* ]]; then
      [[ $path == $pat ]] && return 0
    else
      [[ $name == $pat ]] && return 0
    fi
  done < "$IGNORE_FILE"
  return 1
}

# Make directory $1 a new repository: git init, add/ignore its files, an
# initial commit, and optionally a new GitHub repository to push it to
handle_new_repo() {
  local dir=$1 vis
  git init -q -- "$dir" || return
  echo "  │    Initialized a git repository in $dir"
  handle_untracked "$dir"
  handle_commit "$dir"
  [ "$have_gh" = true ] || return
  if grep -qixF -- "$dir" <<< "$repos"; then
    echo "  │    $owner/$dir already exists on GitHub; not creating it"
    return
  fi
  ask "Create GitHub repository $owner/$dir? [p]rivate, p[u]blic, [n]o, [q]uit" "punq"
  case $reply in
    p ) vis=--private ;;
    u ) vis=--public ;;
    n ) return ;;
    q ) exit 0 ;;
  esac
  if git -C "$dir" rev-parse -q --verify HEAD > /dev/null; then
    gh repo create "$dir" "$vis" --source "$dir" --remote origin --push
  else
    gh repo create "$dir" "$vis" --source "$dir" --remote origin
  fi
}

# Offer to make non-repository directory $1 a repository, or stop flagging it
handle_not_repo() {
  ask "Not a git repository. [g]it init (new repo), [i]gnore from now on, [s]kip, [q]uit?" "gisq"
  case $reply in
    g ) handle_new_repo "$1" ;;
    i ) mkdir -p "$CONF_DIR" &&
        printf '%s\n' "$top/$1" | sed 's/[][*?\\]/\\&/g' >> "$IGNORE_FILE" &&
        echo "  │    Won't flag it again (undo: remove it from $IGNORE_FILE)" ;;
    q ) exit 0 ;;
  esac
}

# GitHub repositories (owner/name, one per line) never to offer to clone
NOCLONE_FILE=$CONF_DIR/noclone

is_noclone() {
  [ -f "$NOCLONE_FILE" ] && grep -qxF -- "$1" "$NOCLONE_FILE"
}

# Offer to clone each GitHub repository in the array named $1 into the
# current directory
handle_clone() {
  local -n names=$1
  local name
  for name in "${names[@]}"; do
    is_noclone "$owner/$name" && continue
    ask "Clone $owner/$name? [y]es, [n]o (don't ask again), [s]kip, [q]uit" "ynsq"
    case $reply in
      y ) gh repo clone "$owner/$name" "$name" ;;
      n ) mkdir -p "$(dirname "$NOCLONE_FILE")" &&
          echo "$owner/$name" >> "$NOCLONE_FILE" &&
          echo "  │    Won't ask again (undo: remove it from $NOCLONE_FILE)" ;;
      q ) exit 0 ;;
    esac
  done
}

# Print "owner/name" of the GitHub repository that repo $1's remotes point to
# (origin's if it is one, else the first), or nothing.  Understands https://, ssh://
# and scp-style (git@github.com:owner/name.git) URLs, and ssh host aliases such as
# github.com-work.
github_slug() {
  local key url first="" slug
  local re='^([A-Za-z][A-Za-z0-9+.-]*://)?([^@/]+@)?github\.com[^:/]*(:[0-9]+)?[:/]+([^/]+)/([^/]+)$'
  while read -r key url; do
    url=${url%/}
    [[ $url =~ $re ]] || continue
    slug=${BASH_REMATCH[4]}/${BASH_REMATCH[5]%.git}
    if [ "$key" = remote.origin.url ]; then echo "$slug"; return 0; fi
    [ -n "$first" ] || first=$slug
  done < <(git -C "$1" config --get-regexp '^remote\..*\.url$')
  [ -z "$first" ] || echo "$first"
  return 0
}

# True if GitHub repository $1 (owner/name) exists: it is in the signed-in user's
# list (names compare without regard to case), or gh can look it up (which also covers
# other owners, organisations, renamed repositories and a list cut off at its limit)
github_exists() {
  local slug=$1 slug_owner=${1%%/*}
  if [ "${slug_owner,,}" = "${owner,,}" ]; then
    grep -qixF -- "${slug#*/}" <<< "$repos" && return 0
  fi
  gh repo view "$slug" --json name > /dev/null 2>&1
}

# GitHub repositories (owner/name, lower case) that the directories processed are
# clones of, so that they are not reported as "not cloned here"
cloned=""

# Flags
list_repos=false
check_changes=false
fetch_compare=false
no_fetch=false
list_branches=false
check_large_files=false
display_summary=false
interactive=false

# Parse options
while getopts "ucfNblsiVh" opt; do
  case ${opt} in
    u ) list_repos=true ;;
    c ) check_changes=true ;;
    f ) fetch_compare=true ;;
    N ) no_fetch=true ;;
    b ) list_branches=true ;;
    l ) check_large_files=true ;;
    s ) display_summary=true ;;
    i ) interactive=true ;;
    V ) echo "$PROG $VERSION"; exit 0 ;;
    h ) usage 0 ;;
    * ) usage ;;
  esac
done

# If no options provided, show usage
if [ $OPTIND -eq 1 ]; then
    usage
fi
if [ "$interactive" = true ] && [ "$check_changes" != true ] && [ "$list_repos" != true ]; then
  echo "$PROG: -i needs -c and/or -u" >&2
  usage
fi
shift $((OPTIND - 1))
[ $# -gt 1 ] && usage
# Answers are read on fd 9, opened once (stdin may be redirected inside loops)
if [ "$interactive" = true ]; then
  exec 9< "$TTY" || exit 1
fi
if [ $# -eq 1 ]; then
  cd -- "$1" || exit 2
fi
top=$(pwd -P)

# Finished branches waiting for a clean-up script: with -c, if DIR holds a non-empty
# tmp-branches.txt (one "repo branch" per line; blank lines and # comments ignored) and
# an executable clean-up-branches.sh, say so, and with -i offer to run it before the
# branches are checked (so branches that are done are removed, not offered a push).
CLEANUP_LIST=tmp-branches.txt
CLEANUP_SCRIPT=clean-up-branches.sh
handle_cleanup() {
  local list=$top/$CLEANUP_LIST script=$top/$CLEANUP_SCRIPT n
  [ -f "$list" ] && [ -x "$script" ] || return 0
  n=$(grep -cvE '^[[:space:]]*(#|$)' "$list")
  [ "${n:-0}" -gt 0 ] || return 0
  echo "Clean-up pending: $n finished branch(es) listed in $CLEANUP_LIST"
  if [ "$interactive" != true ]; then
    echo "  (run ./$CLEANUP_SCRIPT, or use -i to be offered it here)"
    echo
    return 0
  fi
  while true; do
    ask "Run $CLEANUP_SCRIPT first? [y]es, [d]ry run (-n) first, [n]o, [q]uit" "ydnq"
    case $reply in
      y ) (cd "$top" && "./$CLEANUP_SCRIPT"); echo; return 0 ;;
      d ) (cd "$top" && "./$CLEANUP_SCRIPT" -n) ;;
      n ) echo; return 0 ;;
      q ) exit 0 ;;
    esac
  done
}
[ "$check_changes" = true ] && handle_cleanup

# List the signed-in user's GitHub repositories (skipped without gh)
have_gh=false
if command -v gh &> /dev/null &&
   owner=$(gh api user --jq .login 2>/dev/null) && [ -n "$owner" ]; then
  have_gh=true
  repos=$(gh repo list "$owner" --limit 1000 --json name --jq '.[].name')
fi

# Process each directory
for dir in */; do
  # Remove trailing slash
  dir=${dir%/}
  
  # Skip if not a directory
  [ ! -d "$dir" ] && continue
  
  if [ -e "$dir/.git" ]; then
    echo "Processing $dir..."

    # -c and -f: fetch first (and prune branches deleted on the remote), so the checks
    # see the remotes as they are now rather than as of the last fetch
    if { [ "$check_changes" = true ] || [ "$fetch_compare" = true ]; } &&
       [ "$no_fetch" != true ] && git -C "$dir" remote | grep -q .; then
      git -C "$dir" fetch --all --prune -q < /dev/null &>/dev/null ||
        echo "  ├─ ${WARN}Fetch failed; remotes are as of the last successful fetch${NORM}"
    fi

    # Check GitHub connection
    slug=$(github_slug "$dir")
    if [ -n "$slug" ]; then
      cloned+=$'\n'"${slug,,}"
      echo -n "  ├─ Linked to GitHub: "
      if [ "$have_gh" != true ]; then
        echo "Yes"
      elif github_exists "$slug"; then
        echo "Yes (exists on GitHub)"
      else
        echo "Yes (but NOT on GitHub)"
      fi
    elif is_local_only_repo "$dir"; then
      echo "  ├─ Linked to GitHub: No (local-only repository)"
    else
      echo "  ├─ Linked to GitHub: No"
    fi
    
    # Check for uncommitted changes
    if [ "$check_changes" = true ]; then
      status=$(git -C "$dir" status --porcelain)
      if [ -n "$status" ]; then
        branch=$(git -C "$dir" symbolic-ref --short -q HEAD ||
                 echo "detached at $(git -C "$dir" rev-parse --short HEAD 2>/dev/null)")
        tracked=$(grep -vc '^??' <<< "$status")
        untracked=$(grep -c '^??' <<< "$status")
        echo "  ├─ Uncommitted changes: Yes (branch: $branch)"
        echo "  │  ├─ Tracked files changed: $tracked"
        echo "  │  └─ Untracked files: $untracked"
        if [ "$interactive" = true ]; then
          handle_untracked "$dir"
          handle_commit "$dir"
        fi
      else
        echo "  ├─ Uncommitted changes: No"
      fi

      if report_unpulled "$dir" && [ "$interactive" = true ]; then
        handle_pull "$dir"
      fi

      # Commits on local branches that are not on their upstream (or, with none, on
      # no remote-tracking branch at all)
      unpushed=""
      if is_local_only_repo "$dir"; then
        echo "  ├─ Unpushed commits: not checked (local-only repository)"
      else
        flagged=false
        while IFS= read -r b; do
          n=$(unpushed_count "$dir" "$b")
          if [ -z "$n" ]; then
            unpushed+="  │  └─ $b: ${WARN}could not count${NORM}"$'\n'
            flagged=true
          elif [ "$n" -gt 0 ]; then
            unpushed+="  │  └─ $b: $n"
            if is_local_only "$dir" "$b"; then unpushed+=" (local only)"; else flagged=true; fi
            unpushed+=$'\n'
          fi
        done < <(git -C "$dir" for-each-ref --format='%(refname:lstrip=2)' refs/heads)
        if [ -n "$unpushed" ]; then
          # branches marked "local only" are listed but do not count as unpushed
          if [ "$flagged" = true ]; then
            echo "  ├─ Unpushed commits: Yes"
          else
            echo "  ├─ Unpushed commits: No (only on local-only branches)"
          fi
          printf '%s' "$unpushed"
          [ "$interactive" = true ] && handle_push "$dir"
        else
          echo "  ├─ Unpushed commits: No"
        fi
      fi
    fi
    
    # Fetch and compare commits
    if [ "$fetch_compare" = true ]; then
      echo -n "  ├─ Remote status: "
      if ! git -C "$dir" remote | grep -q .; then
        echo "No remotes configured"
      else
        if ! git -C "$dir" rev-parse @{u} &>/dev/null; then
          echo "No upstream branch set"
        else
          local_branch=$(git -C "$dir" rev-parse @)
          remote_branch=$(git -C "$dir" rev-parse @{u})
          base_branch=$(git -C "$dir" merge-base @ @{u})
          
          if [ "$local_branch" = "$remote_branch" ]; then
            echo "Up to date"
          elif [ "$local_branch" = "$base_branch" ]; then
            echo "Behind remote"
          elif [ "$remote_branch" = "$base_branch" ]; then
            echo "Ahead of remote"
          else
            echo "Diverged from remote"
          fi
        fi
      fi
    fi
    
    # List branches
    if [ "$list_branches" = true ]; then
      echo "  ├─ Branches:"
      git -C "$dir" branch -a | sed 's/^/  │  /'
    fi
    
    # Check for large files
    if [ "$check_large_files" = true ]; then
      echo "  ├─ Checking for large files (>1MB)..."
      # ls-tree -l: "<mode> <type> <object> <size>\t<path>"
      git -C "$dir" ls-tree -r -l HEAD 2>/dev/null |
        awk -F '\t' '{ split($1, f, " ") }
                     f[4] != "-" && f[4] >= 1000000 {
                       printf "  │  └─ %s: %.2fMB\n", $2, f[4] / 1000000 }'
    fi
    
    # Display repository summary
    if [ "$display_summary" = true ]; then
      echo "  └─ Summary:"
      commit_count=$(git -C "$dir" rev-list --all --count)
      branch_count=$(git -C "$dir" branch | wc -l)
      recent_activity=$(git -C "$dir" log -1 --format="%cd" --date=relative 2>/dev/null || echo "No commits")
      echo "      Commits: $commit_count"
      echo "      Branches: $branch_count"
      echo "      Last commit: $recent_activity"
    fi
    
    echo ""
  elif ! is_ignored "$dir"; then
    echo "$dir: Not a Git repository"
    [ "$interactive" = true ] && handle_not_repo "$dir"
    echo ""
  fi
done

# GitHub repositories with no local directory of the same name
if [ "$list_repos" = true ]; then
  if [ "$have_gh" != true ]; then
    echo "GitHub repositories not cloned here: unknown (gh is not installed or not signed in)"
  else
    missing=()
    while IFS= read -r name; do
      [ -z "$name" ] || [ -e "$name" ] ||
        grep -qixF -- "$owner/$name" <<< "$cloned" || missing+=("$name")
    done <<< "$repos"
    if [ ${#missing[@]} -eq 0 ]; then
      echo "GitHub repositories not cloned here: None"
    else
      echo "GitHub repositories not cloned here:"
      for name in "${missing[@]}"; do
        if is_noclone "$owner/$name"; then
          echo "  └─ $name (don't clone)"
        else
          echo "  └─ $name"
        fi
      done
      if [ "$interactive" = true ]; then
        handle_clone missing
      fi
    fi
  fi
fi
exit 0
